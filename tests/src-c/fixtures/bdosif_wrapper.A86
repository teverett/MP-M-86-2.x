; Standalone wrapper for src/kernel/BDOSIF.BDO's `init`. `entry` (the
; module's own inter-module BDOS dispatch) is not ported -- same
; reasoning as every other module dispatcher in this tree (see
; cioif_wrapper.A86's own header comment) -- declared as a bare `ret`
; marker here, never executed.
;
; `init`'s own cseg header (`jmp init ! jmp entry ! sysdat dw 0 !
; supervisor equ (offset $) ! dw 3 ! dw 0`, plus the copyright/serial
; strings) and `init:` itself are hand-transcribed below, verified
; directly against src/kernel/BDOSIF.BDO line for line -- NOT `include
; bdosif.bdo`, unlike every other module-dispatcher wrapper in this
; tree. BDOSIF.BDO is one file combining `init`/`mpmif`/`entry` with
; its own `entry`-only `getdiskmx` helper (`or p_flag[bx],pf_tempkeep`)
; that tools/asm86.py's own operand-combination support can't assemble
; at all (confirmed directly: assembling src/kernel/BDOSIF.BDO alone
; fails there) -- a toy-assembler limitation, not a real 8086
; encoding issue, but since the whole file has to assemble whether or
; not `getdiskmx` ever runs, `init` can't be reached by `include`ing
; the real file the way every other such wrapper does.
;
; `mpmif` itself is BDOSIF.BDO's own real near label (`ES =
; P_UDA[RLR]` then `callf cs:[supervisor]`) -- a genuine indirect far
; call with no real-redirect capability in tools/i86sim.py (only a
; no-op `far_call_stub_addrs`, confirmed via that module's own
; docstring/CALL-FAR-[mem] handling), so it can't be driven through to
; a real target the way RTMIF.RTM's own single *near* `call
; proc_creat` could (rtmif_wrapper.A86's own header comment). Declared
; here instead as a fresh near dispatcher, same convention
; cpmmem_wrapper.A86 already uses for its own `mpmif` (a real
; dispatcher keyed on `cx`, tail-jumping into the real queue routine)
; -- `f_qmake`/`f_qopen`/`f_qwrite` tail-jump into QUE1.RTM's real
; `makeq_entry`/`openq_entry`/`writeq_entry` (included for real
; below), any other code falls through to a bare `ret` (never hit).
;
; QUE1.RTM/QUE2.RTM's own `cs:sysdat` references (push es!mov
; es,cs:sysdat, etc.) resolve to this same file's own `sysdat` cell
; (declared once, above, for BDOSIF's own `mov cs:sysdat,ds`) -- QUE1.
; RTM/QUE2.RTM never declare `sysdat` themselves (que_wrapper.A86's
; own header comment confirms this, supplying its own standalone
; `sysdat dw 0` cell there for the same reason), so this isn't a
; symbol collision: it's the same single shared cell both modules'
; own `init` would independently set to the same ambient SYSDAT
; segment in the real system anyway.
;
; `supmod` is a DSEG label at the same flat `SD_SUPMOD_OFF`/
; `SD_SUPMOD_SEG` address every other such wrapper uses (not its real
; raw SYSDAT.FMT offset -- see cioif_wrapper.A86's own header comment
; for why). `mxdiskqd`/`mxdiskqpb` (src/kernel/DATA.BDO) are likewise
; DSEG labels at `SD_MXDISKQD`/`SD_MXDISKQPB`, the flat scratch
; addresses src-c/kernel/defs.h's own macros use -- not their real raw
; offset within the combined SYSDAT.FMT+DATA.BDO dseg (probed
; directly: 0xf92/0xfae). Reserved here as bare space (`rb`), not
; given inline initializer bytes -- DSEG content is never copied into
; the simulator's own memory image (only `cseg` is, same as every
; other wrapper in this tree), so tests/src-c/test_bdosif.py pokes
; DATA.BDO's own real initial field values (an MX queue named
; "MXdisk", nmsgs=1, msglen=0) in directly, same style test_que.py
; already uses for its own QD/QPB fixtures.
;
; `rlr`/`u_wrkseg`/`qlr`/`qul`/`qmau`/`endseg` are DSEG labels at the
; same flat scratch addresses que_wrapper.A86 already established for
; QUE1.RTM/QUE2.RTM's own standalone test (see that file's own header
; comment) -- this wrapper and tests/src-c/test_bdosif.py must agree
; with that same convention, not invent a new one, since que1.c/que2.c
; are already independently verified against it.
	include system.def
	include pd.def
	include err.def
	include qd.def
	include mpb.def
	include modtab.def
	include modfunc.def
	dseg
	org	0A000h
rlr		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A020h
qlr		dw	0
qul		dw	0
qmau		dw	0
endseg		dw	0
	org	0A88Dh
supmod		rw	2
	org	0A0C0h
mxdiskqd	rb	qdlen
	org	0A0E0h
mxdiskqpb	rb	qpblen
	cseg
	org	0
	jmp init	;BDOS initialization
	jmp entry	;inter module entry pt.
sysdat	dw	0	;seg address of sysdat
supervisor	equ	offset $
	dw	3
	dw	0	;SUP segment
	db	'COPYRIGHT (C) 1981,'
	db	' DIGITAL RESEARCH '
serial	db	'654321'
init:
	mov cs:sysdat,ds
	mov bx,offset supmod ! mov si,offset supervisor
	mov ax,[bx] ! mov cs:[si],ax
	mov ax,2[bx] ! mov cs:2[si],ax
		; create disk mx queue
	mov dx,offset mxdiskqd ! mov cx,f_qmake
	call mpmif
		; open mx disk queue
	mov dx,offset mxdiskqpb ! mov cx,f_qopen
	call mpmif
		; write mx disk queue
	mov dx,offset mxdiskqpb ! mov cx,f_qwrite
	call mpmif
	retf
entry:	ret
mpmif:
	cmp cx,f_qmake ! je mpmif_qmake
	cmp cx,f_qopen ! je mpmif_qopen
	cmp cx,f_qwrite ! je mpmif_qwrite
	ret
mpmif_qmake:	jmp makeq_entry
mpmif_qopen:	jmp openq_entry
mpmif_qwrite:	jmp writeq_entry
	include que1.rtm
	include que2.rtm
	end

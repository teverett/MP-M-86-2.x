;       title   'Bdos Interface, Bdos, Version 2.2 Feb, 1980'
;*****************************************************************
;*****************************************************************
;**                                                             **
;**			L o a d e r				**
;**   B a s i c    D i s k   O p e r a t i n g   S y s t e m    **
;**            I n t e r f a c e   M o d u l e                  **
;**                                                             **
;*****************************************************************
;*****************************************************************
;
;       Copyright (c) 1978, 1979, 1980
;       Digital Research
;       Box 579, Pacific Grove
;       California
;
;
;       5 september, 1980
;	smaller version of BDOS for CP/M-86 Loader	
;
;**********************************************
;
cpmsegment      equ     0	; base of CP/M-86
ldroffset       equ     0   	; offset of CPMLDR
;
; bdosoffset/biosoffset are DRI's own fixed-layout values, carried over
; unmodified from the real LDBDOS.A86 in spirit (both are still "this
; module's own absolute position" and "LDBIOS's absolute position",
; just no longer DRI's own fixed numbers). DRI's build placed this
; module via Intel-hex "pip" (sparse, absolute-address records -- no
; file bytes at all for addresses this module doesn't use), so an `org
; bdosoffset` there cost nothing regardless of value. tools/asm86 emits
; raw binary instead, where the same `org` means literal zero-byte
; padding from file offset 0 up to bdosoffset.
;
; That padding is exactly what's needed here, not a bug to avoid: this
; module's own code (LBDOSENT.A86's `org bdosoffset`) and data
; (LBDOSDAT.A86's cseg-resident variables, right after it) use plain
; `offset <label>`/direct addressing throughout, assuming DS=SS=CS=the
; one shared MPMLDR segment (same convention as LDBIOS86Q.A86) -- which
; is only correct if bdosoffset, the position every one of those
; addresses is computed relative to, equals this module's real,
; absolute position in the concatenated MPMLDR.bin. A previous fix
; zeroed bdosoffset instead, to stop tools/build_mpmldr.py's then-
; sequential-only placement from stacking that padding *on top of*
; where it placed this module -- confirmed by inspecting the combined
; MPMLDR.bin (see docs/bugs.md's LDBDOS entry) -- but zeroing it just
; traded that bug for the LDBIOS86Q.A86 one: `lea sp,endstack` (and
; every other local `offset`/direct reference) then computed an address
; relative to module-local 0, not this module's real position
; (`ldbdos_offset`), pointing SP ~0x3ef bytes too low, into LDMPM.A86's
; own code -- confirmed via testing in QEMU, past the loader's own
; signon message. Fixed the same way as LDBIOS86Q.A86's own `org
; mldbios_offset` fix: bdosoffset is now this module's real, self-
; corrected absolute position (tools/build_mpmldr.py strips the
; resulting leading zero-padding before concatenating, the same way);
; biosoffset (an absolute CALL/JMP target into LDBIOS86Q.A86's own jump
; table) is self-corrected the same way it already was. The value below
; is only a seed for that first assemble-and-measure pass.
bdosoffset      equ     3edh	; LDBDOS's own position within MPMLDR.bin
				; (self-corrected -- see above)
biosoffset      equ     1113h   ; offset of LBIOS-86 (self-corrected)
;
eject ! include lbdosequ.a86	 ; symbol definition
eject ! include lbdosent.a86     ; entry module
eject ! include lbdosnew.a86     ; new 8086 BDOS functions
eject ! include lbdosio.a86      ; byte I/O module
eject ! include lbdosf1.a86      ; file system part 1
eject ! include lbdosf2.a86      ; file system part 2
eject ! include lbdosf3.a86      ; file system part 3
eject ! include lbdosdat.a86     ; data area
eject
;********************** end of BDOS ********************
end

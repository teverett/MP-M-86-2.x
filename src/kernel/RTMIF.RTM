;*****************************************************
;*
;*	RTM Interface Routines
;*
;*****************************************************

	cseg
	org 0

	jmp init		;RTM initialization
	jmp entry		;RTM entry point

sysdat		dw	0	;SYSDAT segment
supervisor	equ	offset $
		rw	2	;SUP entry point

		db	'COPYRIGHT (C) 1981,'
		db	' DIGITAL RESEARCH '
serial		db	'654321'

;====		===========================
init:		; RTM module Initialization
;====		===========================
	mov cs:sysdat,ds		;save sysdat -- bare write is wrong here,
					;same bug class/fix as INIT.SUP's "init:"
					;(see its own comment) -- lands on SYSDAT's
					;own offset 6 (module_table[sup].init_seg)
					;instead of this module's own cseg cell
	mov bx,offset supmod		;init supif
	mov si,offset supervisor
	mov ax,[bx]
	mov cs:[si],ax
	mov ax,2[bx]
	mov cs:2[si],ax
	mov bx,(offset dispatcher)	;init interrupt pdisp
	mov word ptr [bx],offset fdisp
	mov word ptr 2[bx],cs
	mov bx,(offset rtm_pdisp)	;init intermodule pdisp
	mov word ptr [bx],offset farpdisp
	mov word ptr 2[bx],cs
		;create tick and idle process
	mov bx,offset tickpd		;Tick
	mov ax,p_uda[bx]
	add ax,cs:sysdat
	push es ! mov es,ax
	mov si,offset supervisor
	mov ax,cs:2[si]
	mov u_initcs,ax
	mov ax,cs:sysdat ! mov u_initss,ax	;u_initss (same unanswered-
					;GENSYS-question bug class as
					;c_mimic/mpmseg -- SYSTEM.DAT's own
					;stock tickuda/idleuda template leaves
					;this 0 instead of the real sysdat
					;segment) -- PROC.RTM's own cp_uda
					;copies u_initss into u_ss (tick/
					;idle's own *first-ever* resume
					;stack segment, used by DSPTCH.RTM's
					;"switch:" the very first time either
					;is dispatched), paired with
					;u_stack_sp (already correctly
					;template-set to offset(idle_tos)/
					;offset(tick_tos), both *inside*
					;this same sysdat segment) -- left at
					;0, idle's/tick's own very first
					;stack becomes SS=0000h, the IVT/BIOS
					;data area, not sysdat. Confirmed live
					;via GDB: idle's own UDA u_initss read
					;back 0 exactly where this fix now
					;writes cs:sysdat; with it 0, idle's
					;own first-ever "switch:" leaves
					;u_ss=0 permanently (nothing else ever
					;rewrites it to anything sane), and
					;every later real dispatch bails
					;immediately on DSPTCH.RTM's own
					;`indisp` reentrancy guard once it's
					;left set -- the actual, direct cause
					;of this build's console input never
					;working: the scheduler never
					;performs a real process switch again
					;after idle's own first run, so a
					;process that legitimately blocked
					;waiting for console input (e.g. TMP)
					;is never revisited.
	pop es
	mov bx,offset idlepd		;IDLE
	mov ax,p_uda[bx]
	add ax,cs:sysdat
	push es ! mov es,ax
	mov si,offset supervisor
	mov ax,cs:2[si]
	mov u_initcs,ax
	mov ax,cs:sysdat ! mov u_initss,ax	;see tick's own fix above
	pop es
	mov dx,bx ! call proc_creat
		;init is now a process and can run
		;concurrently with idle process
	retf

;*****************************************************
;*
;*	RTM Function Table
;*
;*****************************************************

function	dw	sysreset_entry	;0
		dw	poll_entry	;1
		dw	flag_wait_entry	;2
		dw	flag_set_entry	;3
		dw	makeq_entry	;4
		dw	openq_entry	;5
		dw	deleteq_entry	;6
		dw	readq_entry	;7
		dw	creadq_entry	;8-conditional readq
		dw	writeq_entry	;9
		dw	cwriteq_entry	;10-conditional writeq
		dw	delay_entry	;11
		dw	dispatch_entry	;12
		dw	terminate_entry	;13
		dw	creat_proc_entry;14
		dw	set_prior_entry	;15
		dw	pd_entry	;16-get PD address
		dw	abort_spec_entry;17-abort process
		dw	sleep_entry	;18
		dw	wakeup_entry	;19
		dw	findpdname_entry;20

;=====		=================
entry:		; RTM Entry Point
;=====		=================
	mov ch,0 ! shl cx,1 ! mov si,cx
	call cs:function[si]
rtm_ret:retf

;=====		===============
mpmif:		; MPM Interface
;=====		===============
	callf cs:dword ptr .supervisor ! ret

;======		================
xiosif:		; XIOS Interface
;======		================
	mov si,mod_entry
	callf dword ptr xiosmod[si] ! ret

; Standalone wrapper for src-assem/loader/LBDOSF3.A86 -- see
; src-c/loader/lbdosf3.c's own header comment for exactly what's
; ported and what's deferred.
;
; Same minimal-wrapper approach as lbdosf2_wrapper.A86's own, extended
; with LBDOSF3.A86 itself.
cpmsegment	equ	0
biosoffset	equ	0
	include lbdosequ.a86
addlist		equ	8
dpblist		equ	15
	dseg
pererr		dw	0
roderr		dw	0
rofer		dw	0
seler		dw	0
	org	0B000h
kbchar		db	0
compcol		db	0
column		db	0
listcp		db	0
aret		dw	0
lret		equ	byte ptr aret
	org	0B010h
curdsk		db	0
info		dw	0
rodsk		dw	0
dmaad		dw	0
cdrmaxa		dw	0
curtrka		dw	0
curreca		dw	0
buffa		dw	0
dpbaddr		dw	0
checka		dw	0
alloca		dw	0
sectpt		dw	0
blkshf		db	0
blkmsk		db	0
extmsk		db	0
maxall		dw	0
dirmax		dw	0
chksiz		dw	0
offsetv		dw	0
tranv		dw	0
seqio		db	0
single		db	0
rcount		db	0
extval		db	0
vrecord		dw	0
lvrecord	equ	byte ptr vrecord
arecord		dw	0
ablock		dw	0
dptr		db	0
dcnt		dw	0
ldcnt		equ	byte ptr dcnt
drec		dw	0
dmabase		dw	0
parametersegment dw	0
; LBDOSF2.A86's own new scratch fields
dirblk		dw	0
usrcode		db	0
dirloc		db	0
srchl		db	0
srcha		dw	0
rmf		db	0
fcbcopied	db	0
efcb		db	0e5h
; LBDOSF3.A86/LBDOSENT.A86's own new scratch fields
dlog		dw	0
resel		db	0
fcbdsk		db	0
olddsk		db	0
linfo		db	0
parcopfl	db	0
parlg		db	0
infosave	dw	0
loc_par_area	rb	258
	cseg
	include lbdosio.a86
	include lbdosf1.a86
	include lbdosf2.a86
; parsave/parsave33/parunsave are real LBDOSENT.A86 routines (copied
; here verbatim rather than `include lbdosent.a86`, which needs its
; own dispatch table's/8086-function-table's own dependencies this
; wrapper has no other use for) -- see src-c/loader/lbdosf3.c's own
; header comment for why these 3 are ported despite living in that
; otherwise-deferred module.
parsave:
        push    ds
        push    ax
        push    cx
        mov     parcopfl,true
        mov     parlg,cl
        xor     ch,ch
        mov     si,info
        mov     infosave,si
        lea     di,loc_par_area
        mov     info,di
	mov	ds,parametersegment
rep     movs    al,al
        pop     cx
        pop     ax
        pop     ds
        ret
parsave33:
        push    cx
        mov     cl,33
        jmps    pscommon
parsave36:
        push    cx
        mov     cl,36
pscommon:
        call    parsave
        pop     cx
        ret
parunsave:
        push    es
        push    ax
        push    cx
        mov     cl,parlg
        xor     ch,ch
        mov     es,parametersegment
        lea     si,loc_par_area
        mov     di,infosave
        mov     info,di
rep     movs    al,al
        pop     cx
        pop     ax
        pop     es
        ret
	include lbdosf3.a86
	end

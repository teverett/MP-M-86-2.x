
;*****************************************************
;*
;*	SUPERVISOR INTERFACE ROUTINES
;*
;*****************************************************

;=========
user_entry:
;=========
;	User Entry Point - enter here from a INT 224
;
;		REGISTER USAGE
;	INPUT			OUTPUT
;	-----			------
;  CL - Function Code	  AX - Copy of BX
;  DL - Byte Param	  BX - Return
;  DX - Word Param	  CX - Error Code	
;			  ES - Segment Return
;
;		SETUP FOR ENTRY POINTS
;		----------------------
;	contents of users stack
;		Flags
;		CS
;		IP		<- u_stack_ss,_sp
;	in u_stack of uda:
;		DS 
;		user_ret	<- SS,SP
;	DS =  Sysdat Segment
;	ES -> user_data_area
;	BX -> pd address
;	DX -> function parameter
;	u_wrkseg == user's DS
;	u_retseg == user's ES

		;initialize critical areas
	push ax ! mov al,'@' ! mov dx,03f8h ! out dx,al ! pop ax	;TEMP DEBUG PROBE
	cld ! mov di,ds			;DI=user's DSEG
	mov ds,sysdat ! mov bx,rlr	;BX=pd address
	mov ax,es ! mov es,p_uda[bx]	;ES=uda
	cmp u_insys,0 ! jne noswt
	    mov u_stack_ss,ss		;switch stacks
	    mov u_stack_sp,sp
	    mov bp,es ! mov ss,bp
	    mov sp,ulen
	    jmps uecont
noswt:	push u_wrkseg
uecont:	inc u_insys
		;enable interrupts if intflag
	cmp intflag,0 ! je noints
	    sti
noints:		;initialized non-critical areas
	mov u_retseg,ax
	mov u_wrkseg,di
	push ax ! push dx ! push cx ! mov al,'#' ! mov dx,03f8h ! out dx,al ! mov ax,cx ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop cx ! pop dx ! pop ax	;TEMP DEBUG PROBE
	mov ch,0 ! call func	; execute function
	mov ax,bx		; for INTEL's PL/M
	mov ds,u_wrkseg ! cli
	dec u_insys
	cmp u_insys,0 ! jne nstk
	    mov ss,u_stack_ss	; restore user's stack
	    mov sp,u_stack_sp
	    jmps ueout
nstk:	pop u_wrkseg
ueout:	mov es,u_retseg
	iret  			; back to user

func:		; call system function
;----		-----------------------
;	input:	CH = module (for explicit module function)
;			bypassing network check...
;		     0 if User function.
;			network check is done
;		CL = function #
;		DX = arg

	push ax ! push cx ! push dx ! mov al,'Y' ! mov dx,03f8h ! out dx,al ! mov ax,es ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop cx ! pop ax	;TEMP DEBUG PROBE
	mov u_func,cl
func1:	cmp ch,0 ! je userf
	    mov al,ch ! mov ch,0
	    jmps inmod
userf:	mov si,cx ! shl si,1 ! add si,cx
	add si,offset sysent
	test ent_flag[si],ef_network ! jz nonet
	    test module_map,netmod_bit ! jz nonet
	    push si ! callf dword ptr .netmod ! pop si
	    cmp al,true ! jne nonet
		mov si,0 ! mov ax,bx ! ret
nonet:	mov cl,ent_func[si] ! mov ch,0
	mov al,ent_mod[si]
		;AL=mod,CL=func,CH=0
	push ax ! push dx ! mov al,'Q' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	push ax ! push dx ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
inmod:	cmp al,sup ! jne gofar
	    shl cx,1 ! mov si,cx
	    jmp cs:supfunc[si]
gofar:	push cx ! mov cx,ax ! dec cl
	push ax ! push dx ! push cx ! mov al,'Z' ! mov dx,03f8h ! out dx,al ! mov al,cl ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop cx ! pop dx ! pop ax	;TEMP DEBUG PROBE
	push ax ! push dx ! mov al,'d' ! mov dx,03f8h ! out dx,al ! mov ax,ds ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	mov al,module_map
	push ax ! push dx ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	shr al,cl
	push ax ! push dx ! mov al,'R' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	push ax ! push dx ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	and al,1 ! jnz goodmod
	    pop cx ! mov cx,e_not_implemented
	    push ax ! mov al,'U' ! mov dx,03f8h ! out dx,al ! pop ax	;TEMP DEBUG PROBE
	    mov bx,0ffffh ! mov ax,bx ! ret
goodmod:
	push ax ! push dx ! mov al,'S' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	mov ch,0 ! mov si,cx
	mov cl,3 ! shl si,cl ! pop cx
	push ax ! push dx ! push cx
	mov ax,cx ! call zdbg ! mov al,':' ! mov dx,03f8h ! out dx,al	;TEMP DEBUG PROBE: CX (module#,local func#)
	mov ax,word ptr module_table[si] ! call zdbg ! mov al,':' ! mov dx,03f8h ! out dx,al	;TEMP DEBUG PROBE: target offset
	mov ax,word ptr module_table[si+2] ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al	;TEMP DEBUG PROBE: target segment
	pop cx ! pop dx ! pop ax
	callf dword ptr module_table[si]
	push ax ! push dx ! mov al,'T' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	ret

;=====
entry:
;=====
; Supervisor module entry point

	cmp cl,f_flagset ! jne entry_notfs
	    mov cx,f_inflagset
	    call func1 ! mov ax,bx ! retf
entry_notfs:
	call mpmif ! retf	

;=====
mpmif:
;=====
	push u_wrkseg
	mov al,u_func ! push ax
	mov u_wrkseg,ds
	mov ds,cs:sysdat	;bare "mov ds,sysdat" only works when the
				;*caller's* ds (just saved above, as
				;u_wrkseg) already happens to be sysdat-
				;ish -- normally true, but not when a
				;caller (QUE2.RTM's qspace) deliberately
				;calls through here with ds pointed at
				;something else (ss, for an on-stack MPB);
				;SUP's own module_base is 0, so cs:sysdat
				;addresses the exact same combined
				;location "mov cs:sysdat,ax" (INIT.SUP)
				;now reliably writes, regardless of
				;what ds currently is
	call func
	mov ds,u_wrkseg
	pop ax ! mov u_func,al
	pop u_wrkseg
	mov ax,bx
	ret

;======
xiosif:
;======
	push ax ! mov al,'X' ! mov dx,03f8h ! out dx,al ! pop ax	;TEMP DEBUG PROBE
	push ax ! push bx ! mov bx,28h ! mov ax,[bx] ! call xdbg ! mov al,':' ! mov dx,03f8h ! out dx,al ! mov bx,2ah ! mov ax,[bx] ! call xdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop bx ! pop ax	;TEMP DEBUG PROBE
	callf dword ptr .xiosmod ! ret

;TEMP DEBUG PROBE
xdbg:
	push ax ! push bx ! push cx ! push dx
	mov cx,0404h
xdbg1:	rol ax,cl
	mov bl,al ! and bl,0fh ! cmp bl,9
	ja xdbg2
	add bl,'0' ! jmp xdbg3
xdbg2:	add bl,'A'-10
xdbg3:	mov dx,03f8h ! push ax ! mov al,bl ! out dx,al ! pop ax
	dec ch ! jnz xdbg1
	pop dx ! pop cx ! pop bx ! pop ax
	ret

;*****************************************************
;*
;*	Supervisor function table
;*
;*****************************************************

supfunc	dw	not_implemented	; 0-not implemented
	dw	bad_entry	; 1-bad function number
	dw	version_entry	; 2-(12)get version
	dw	callbios_entry	; 3-(50)call bios
	dw	load_entry	; 4-(59)user load function
	dw	clicmd_entry	; 5-(150)CLI
	dw	rpl_entry	; 6-(151)Call RPL
	dw	parse_entry	; 7-(152)parse filename
	dw	sysdat_entry	; 8-(154)get sysdat addr
	dw	tod_entry	; 9-(155)get tod addr
	dw	load		; 10-load function
	dw	mpmversion_entry; 11-MP/M version number
	dw	chain_entry	; 12-(47)Program Chain
	dw	serial_entry	; 13-(107)return serial
	dw	cload_entry	; 14-chain load function

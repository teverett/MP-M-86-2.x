; Standalone wrapper for a clean, self-contained subset of src/kernel/
; FILE4.BDO -- see src-c/kernel/file4.c's own header comment for
; exactly which routines and why the rest is deferred.
;
; This is the exact same combined BDOS module bundle as
; tests/src-c/fixtures/file1_wrapper.A86/file2_wrapper.A86 (FILE1-4.BDO +
; BDOSIF.BDO + DATA.BDO, the same bundle src/kernel/BDOS.A86 itself
; assembles) -- FILE4.BDO isn't self-contained either, for the same
; reason FILE1.BDO/FILE2.BDO weren't (see file1_wrapper.A86's own
; header comment for the full rationale). tests/src-c/test_file4.py's
; own run_reference() handles this bundle's own cseg/dseg collision
; the same way tests/src-c/test_file2.py's does (no dseg layering at
; all), plus its own UDA.FMT-specific variant (see that test's own
; header comment).
	include cpyright.def
	include equ.bdo
	include system.def
	include pd.def
	include err.def
	include qd.def
	include modfunc.def
	include xioscb.def
; mpmif AND seldskf/homef/readf/writef/settrkf/sectran/setsecf/
; setdmbf/setdmf are all real labels in BDOSIF.BDO itself -- see
; file1_wrapper.A86's own header comment. Not needed by anything
; file4.c ports, but kept here since the whole module still has to
; assemble as one unit.
	include bdosif.bdo
	include file1.bdo
	include file2.bdo
	include file3.bdo
	include file4.bdo
	include uda.fmt
	include sysdat.fmt
	include data.bdo
	end

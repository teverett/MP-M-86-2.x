; Standalone wrapper for src-assem/loader/LBDOSF1.A86: a near-full standalone
; copy of FILE1.BDO's own disk-I/O/FCB-arithmetic/checksum/rddir/
; getallocbit logic, used by the boot-time loader before the real BDOS
; is running. Unlike the real FILE1.BDO, its checksum/rddir/wrdir chain
; is entirely self-contained in this one file (no FILE2/FILE3/FILE4
; split) -- see src-c/loader/lbdosf1.c's own header comment for exactly
; what's ported and what's deferred.
;
; Same minimal-wrapper approach as lbdosio_wrapper.A86's own (not the
; full LDBDOS.A86 bundle, which pulls in LBDOSENT.A86's own deferred
; `jmp cs:functab[bx]` dispatch + `iret`): constf/coninf/.../readf/
; writef/settrkf/sectran/setsecf/setdmbf/setdmf resolve to small
; numeric offsets right at the start of cseg, coincidentally
; overlapping where this wrapper's own real code begins -- harmless,
; same reasoning as there.
;
; `curdsk`/`info`/etc. are DSEG labels at the scratch addresses
; src-c/loader/defs.h and tests/src-c/test_lbdosf1.py both use (same
; reasoning as every other scratch-address wrapper in this project):
; the real LBDOSDAT.A86 keeps this data in cseg, immediately following
; this module's own code in the real combined LDBDOS.A86 bundle (see
; LBDOSDAT.A86's own header comment) -- a real address this minimal
; wrapper has no reason to reproduce, since nothing here needs to match
; it byte-for-byte.
cpmsegment	equ	0
biosoffset	equ	0
	include lbdosequ.a86
; addlist/dpblist are real LBDOSDAT.A86 size constants (EQUs, not
; storage) selectdisk's own move() calls use as a byte count.
addlist		equ	8		; $-buffa (buffa/dpbaddr/checka/alloca)
dpblist		equ	15		; sectpt..offsetv ($-sectpt)
	dseg
; pererr/roderr/rofer/seler are LBDOSENT.A86's own error-table entries
; -- real word storage holding a subroutine address, which goerr's own
; `JMP w[bx]` jumps to indirectly (so `LEA BX,seler` needs a real
; memory operand, not a plain EQU). Never actually dereferenced under
; this port's convention (see lbdosf1.c's own header comment: goerr/
; selerror are a pure boundary-stub tail, nothing to port past them),
; so the stored value itself doesn't matter.
pererr		dw	0
roderr		dw	0
rofer		dw	0
seler		dw	0
	org	0B010h
curdsk		db	0
info		dw	0
rodsk		dw	0
dmaad		dw	0
cdrmaxa		dw	0
curtrka		dw	0
curreca		dw	0
buffa		dw	0
dpbaddr		dw	0
checka		dw	0
alloca		dw	0
sectpt		dw	0
blkshf		db	0
blkmsk		db	0
extmsk		db	0
maxall		dw	0
dirmax		dw	0
chksiz		dw	0
offsetv		dw	0
tranv		dw	0
seqio		db	0
single		db	0
rcount		db	0
extval		db	0
vrecord		dw	0
lvrecord	equ	byte ptr vrecord
arecord		dw	0
ablock		dw	0
dptr		db	0
dcnt		dw	0
ldcnt		equ	byte ptr dcnt
drec		dw	0
dmabase		dw	0
parametersegment dw	0
	cseg
	include lbdosf1.a86
	end

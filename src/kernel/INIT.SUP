
;*****************************************************
;*
;*	MP/M-86 Supervisor Initialization 
;*
;*****************************************************

	cseg
	org	0

	jmp	init		;system initialization
	jmp	entry		;intermodule entry pt.

sysdat		dw	0		;sysdat segment
supervisor	dw	entry		;Supervisor entry point
		dw	0		;  (segment address)

		db	'COPYRIGHT (C) 1981,'
		db	' DIGITAL RESEARCH '
serial		db	'654321'
ver		db	13,10,10
		db	'MP/M-86 2.0 '
		db	'[5 Oct 81]'
		db	13,10
		db	'Copyright (C) 1981, Digital Research'
		db	13,10,10,'$'

;====
init:
;====
; system initialization
; assume DS = Sysdat Segment
;
	push ax ! mov al,'1' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	push ax ! push bx ! mov ax,ss ! call zdbg ! mov al,':' ! mov dx,03f8h ! out dx,al ! mov ax,sp ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop bx ! pop ax	;TEMP DEBUG PROBE: incoming SS:SP
		;  set up stack,remember DSEG

	mov ax,ds
	mov ss,ax ! mov sp,offset (init_tos)
	mov cs:sysdat,ax	;a bare "mov sysdat,ax" writes via DS
				;(still the real sysdat segment here,
				;cold boot) to SYSDAT's OWN offset 6
				;instead of into this module's own cseg
				;cell at that same bare offset -- SUP's
				;module_base is 0, so "cs:sysdat" and
				;plain "sysdat" happen to address the
				;exact same *combined* location only for
				;this one module, which is exactly why
				;this was never caught: every *read* of
				;bare "sysdat" elsewhere also defaults to
				;DS, so as long as DS is already sysdat-
				;ish wherever it's read, it finds the
				;same (wrong-but-consistent) SYSDAT-
				;resident value this write just put there
				;-- it only breaks once something (like
				;QUE2.RTM's qspace, mid on-stack-MPB trick)
				;calls back in with DS deliberately set to
				;something else, e.g SS
	push ax ! mov al,'2' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE

		; set up supervisor entry point
	mov bx,(offset supmod)+2 ! mov ax,[bx]
	mov si,offset supervisor
	mov cs:2[si],ax

	mov version,offset ver
	mov tick_tos,offset notick
	mov idle_tos,offset idle

		;  set up mpm entry point

	mov ax,ds ! sub bx,bx ! mov ds,bx

	mov i_mpm_ip,offset user_entry
	mov i_mpm_cs,cs
	mov ds,ax

		;initialize init uda

	mov bx,offset initpd
	mov ax,offset inituda
	mov cl,4 ! shr ax,cl
	add ax,cs:sysdat ! mov p_uda[bx],ax	;bare "add ax,sysdat" is wrong --
				;DS is sysdat-ish here (correctly, per the
				;cold-boot assumption), so a bare read of
				;"sysdat" lands on SYSDAT's own offset 6
				;instead of this module's own cseg cell at
				;that same bare offset -- SYSDAT's own
				;offset 6 is the back half of the module
				;table's SUP entry (its "initialize" far
				;pointer's segment word), which happens to
				;equal MPM_CODE_SEG (1000h) since SUP's own
				;module_base is 0. That silently computed
				;p_uda[initpd] = 106Ch instead of the real
				;sysdat-relative uda segment (175Ch-based),
				;landing INIT's own entire UDA (u_insys,
				;u_wrkseg, every other u_* field INIT's own
				;"int mpmint" calls ever touch) squarely
				;inside SUP's own live code bytes instead of
				;in SYSDAT's reserved inituda area --
				;confirmed via GDB: u_insys read back 8Bh (a
				;stray opcode byte, not a small nesting
				;count) at the very first syscall this path
				;ever makes with a non-sysdat-resident PD
				;(RSP creation via nrsp -- every earlier
				;syscall this session happened to tolerate
				;the corruption since it only ever created
				;sysdat-resident PDs). Same bug class, same
				;fix, as mpmif/user_entry's own "sysdat"
				;reads.
	mov es,ax
	mov u_wrkseg,ds

		;initialize modules

	push ax ! mov al,'3' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	mov bx,mod_init
	push bx ! callf dword ptr rtmmod[bx] ! pop bx		; init RTM
	push ax ! mov al,'4' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	push bx ! callf dword ptr memmod[bx] ! pop bx		; init MEM
	push ax ! mov al,'5' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	test module_map,bdosmod_bit ! jz nbdom
	    push bx ! callf dword ptr bdosmod[bx] ! pop bx	; init BDOS
nbdom:	push ax ! mov al,'6' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	push ax ! push bx ! push dx ! mov al,'!' ! mov dx,03f8h ! out dx,al ! mov bx,rlr ! mov ax,p_flag[bx] ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop bx ! pop ax	;TEMP DEBUG PROBE
	test module_map,ciomod_bit ! jz nciom
	    push bx ! callf dword ptr ciomod[bx] ! pop bx	; init CIO
nciom:	push ax ! mov al,'7' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	test module_map,xiosmod_bit ! jz nxiom
	    push ds ! push es
	    callf dword ptr xiosmod[bx] ! pop es ! pop ds	; init XIOS
nxiom:
	push ax ! mov al,'8' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
		;if intflag is non-zero, interrupts
		;are explicitly turned on at the RTM
		;entry point.

	mov intflag,0ffh

		;  reset interrupt vectors

	mov ax,ds ! sub bx,bx ! mov ds,bx
	mov i_mpm_ip,offset user_entry
	mov i_mpm_cs,cs
	mov ds,ax

	push ax ! mov al,'9' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
		; get Character Dev Info from XIOS

	mov ax,io_maxconsole ! call xiosif
	push ax ! mov al,'A' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	mov ncondev,bl ! mov nciodev,bl
	mov ax,io_maxlist ! call xiosif
	push ax ! mov al,'B' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	mov nlstdev,bl ! add nciodev,bl

		; Start RSPs
nrsp:					;loop til done
	push ax ! mov al,'C' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	mov ds,sysdat			;reset DS
	mov cx,rspseg
	push ax ! push dx ! mov al,1Bh ! mov dx,03f8h ! out dx,al ! mov ax,cx ! call zdbg ! pop dx ! pop ax	;TEMP DEBUG PROBE: marker 1Bh, dump rspseg at top of each nrsp iteration
	jcxz rsp_out	;?all done?
	    mov es,cx			;ES->RSP
	    mov ax,es:.rsp_link		;save next RSP
	    mov rspseg,ax
	    mov es:.rsp_link,ds		;give Sysdat to RSP
	    mov si,rsp_pd		;get PD
	    mov ds,cx			;DS = RSP Data Seg
	    mov cx,f_createproc	;Create RSP Process(s) -- was
					;"mov cl,f_createproc" (an 8-bit
					;move, CH untouched): CX still held
					;rspseg from the "mov ds,cx" just
					;above, so CH survived as rspseg's
					;own high byte instead of 0, and
					;func()'s own dispatcher (SUPIF.SUP)
					;reads a nonzero CH as an *explicit
					;module number* rather than routing
					;this as the global function it
					;actually is -- f_createproc's global
					;number (144/90h) got misinterpreted
					;as local function 90h within
					;whatever bogus "module" CH's leftover
					;high byte named, landing miles
					;outside the real 7-slot module_table
					;and reading/jumping through
					;essentially random memory. Confirmed
					;via a serial-trace probe: the very
					;first real "int mpmint" this path
					;ever reaches (this call -- nothing
					;exercised it before now, since
					;rspseg was always 0 until TMP was
					;wired up) printed CX as 1790h, i.e.
					;exactly rspseg's own high byte (17h)
					;joined with f_createproc's low byte
					;(90h), not 0090h.
	    mov dx,si ! int mpmint
	    jmps nrsp			;Do another...
rsp_out:
	push ax ! mov al,'D' ! mov dx,03f8h ! out dx,al  ! push ax ! push dx ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	push ax ! push bx ! push dx ! mov al,'!' ! mov dx,03f8h ! out dx,al ! mov bx,rlr ! mov ax,p_flag[bx] ! call zdbg ! mov al,' ' ! mov dx,03f8h ! out dx,al ! pop dx ! pop bx ! pop ax	;TEMP DEBUG PROBE
		; terminate init process
	mov cl,f_terminate
	mov dl,0ffh ! int mpmint

;TEMP DEBUG PROBE
zdbg:
	push ax ! push bx ! push cx ! push dx
	mov cx,0404h
zdbg1:	rol ax,cl
	mov bl,al ! and bl,0fh ! cmp bl,9
	ja zdbg2
	add bl,'0' ! jmp zdbg3
zdbg2:	add bl,'A'-10
zdbg3:	mov dx,03f8h ! push ax ! mov al,bl ! out dx,al ! pop ax
	dec ch ! jnz zdbg1
	pop dx ! pop cx ! pop bx ! pop ax
	ret

; Standalone wrapper for src/kernel/CPMMEM.MEM's maxmem_entry,
; absmax_entry, cpmalloc_entry, cpmabsa_entry, cpmfree_entry (+ internal
; getmemory, free_memory). freeall_entry is deliberately not wrapped --
; its entire body is a boundary tail-jump into mpmif, nothing to port
; (see cpmmem.c's own header comment).
;
; Every "push ds ! mov ds,u_wrkseg" here is the same already-established
; pattern MEMORY.MEM's malloc_entry/mfree_entry use (a fixed per-process
; scratch segment, not a dynamically-*different*-each-time one) -- not
; the blocked PROC.RTM/ML.MEM/MAU.MEM/SHARE.MEM addressing gap. u_wrkseg
; itself is never actually read by tools/i86sim.py's flat memory model
; (segment overrides are no-ops there), so its own value doesn't matter
; for this wrapper -- it just needs to exist as a word so `mov
; ds,u_wrkseg` assembles.
;
; `rlr` is a DSEG label at the scratch address src-c/kernel/defs.h and
; tests/src-c/test_cpmmem.py both use (see idle_wrapper.A86's comment
; for why, same reasoning as there).
;
; mpmif is now a real dispatcher for f_malloc, same pattern as
; memory_mem_wrapper.A86's own mpmif: tail-jumps into the real
; MEMORY.MEM/MAU.MEM/ML.MEM/UTIL.MEM bundled below, whose own "ret"
; returns straight to getmemory's own caller -- see cpmmem.c's own
; header comment for why getmemory's own f_malloc call is upgraded
; but free_memory's own f_memfree call isn't (yet). mdul/mal/mfl/
; thrdrt are the same scratch dseg labels memory_mem_wrapper.A86 uses.
	include system.def
	include pd.def
	include err.def
	include mem.def
	include mpb.def
	include modtab.def
	include modfunc.def
	dseg
	org	0A000h
rlr		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A028h
mdul		dw	0
mal		dw	0
mfl		dw	0
	org	0A032h
thrdrt		dw	0
	cseg
sysdat	dw	0		; normally supplied by this module's own init
mpmif:
	cmp cx,f_malloc ! je mpmif_malloc
	cmp cx,f_maualloc ! je mpmif_maualloc
	cmp cx,f_mlalloc ! je mpmif_mlalloc
	ret
mpmif_malloc:	jmp malloc_entry
mpmif_maualloc:	jmp maualloc_entry
mpmif_mlalloc:	jmp mlalloc_entry
	include cpmmem.mem
	include memory.mem
	include mau.mem
	include ml.mem
	include util.mem
	end

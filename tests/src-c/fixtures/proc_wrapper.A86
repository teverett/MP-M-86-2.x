; Standalone wrapper for src/kernel/PROC.RTM's freepd/proc_creat (+
; internal getpdadr). The real UDA.FMT/VEC.FMT/SYSDAT.FMT are included,
; so every field resolves to its genuine offset -- the same ones
; src-c/kernel/proc.c uses on real memory. tests/src-c/test_proc.py
; runs this with tools/i86sim.py's segmented=True, a real SYSDAT
; segment, and the code relocated off segment 0 (proc_creat reads the
; real interrupt vectors there).
;
; `sysdat` is normally RTMIF.RTM's own cs cell (`cs:sysdat`); declared
; here at cseg offset 0. `mpmif` is an unported external call target
; (proc_creat's f_share call), stubbed by address.
	include system.def
	include pd.def
	include err.def
	include mem.def
	include modfunc.def

	cseg
sysdat	dw	0
mpmif	equ	9000h
	include proc.rtm

	include uda.fmt
	include vec.fmt
	include sysdat.fmt
	end

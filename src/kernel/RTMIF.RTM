
;*****************************************************
;*
;*	RTM Interface Routines
;*
;*****************************************************

	cseg
	org 0

	jmp init		;RTM initialization
	jmp entry		;RTM entry point

sysdat		dw	0	;SYSDAT segment
supervisor	equ	offset $
		rw	2	;SUP entry point

		db	'COPYRIGHT (C) 1981,'
		db	' DIGITAL RESEARCH '
serial		db	'654321'

;====		===========================
init:		; RTM module Initialization
;====		===========================
	mov cs:sysdat,ds		;save sysdat -- bare "mov sysdat,ds" is wrong
					;here for the exact same reason already fixed
					;in SUPIF.SUP's user_entry/mpmif ("bare 'mov
					;ds,sysdat'...only works when caller's DS
					;already happens to be sysdat-ish"): DS *is*
					;sysdat-ish at this exact point (RTM's own
					;init:'s documented precondition), so a bare
					;write lands on SYSDAT's own offset 6 instead
					;of this module's own cseg cell at that same
					;bare offset -- SYSDAT's own offset 6 is the
					;back half of module_table's SUP entry (its
					;"initialize" far pointer's segment word),
					;confirmed via GDB: module_table[sup].init_seg
					;reads back 1780h (sysdat's own segment, i.e.
					;exactly what this bare write puts there)
					;instead of 1000h (MPM_CODE_SEG) by the time
					;anything downstream reads it. Same bug class,
					;same fix ("cs:sysdat"), as SUPIF.SUP's own.
	mov bx,offset supmod		;init supif
	mov si,offset supervisor
	mov ax,[bx]
	mov cs:[si],ax
	mov ax,2[bx]
	mov cs:2[si],ax
	mov bx,(offset dispatcher)	;init interrupt pdisp
	mov word ptr [bx],offset fdisp
	mov word ptr 2[bx],cs
	mov bx,(offset rtm_pdisp)	;init intermodule pdisp
	mov word ptr [bx],offset farpdisp
	mov word ptr 2[bx],cs
	push ax ! push bx ! mov bx,28h ! mov ax,[bx] ! call ydbg ! pop bx ! pop ax	;TEMP DEBUG PROBE
		;create tick and idle process
	mov bx,offset tickpd		;Tick
	mov ax,p_uda[bx]
	add ax,cs:sysdat		;bare "add ax,sysdat" is wrong -- same bug
					;class as this routine's own "mov
					;sysdat,ds" above (see its comment): reads
					;SYSDAT's own offset 6
					;(module_table[sup].init_seg) instead of
					;this module's own cseg cell at that same
					;bare offset
	push es ! mov es,ax
	mov si,offset supervisor
	mov ax,cs:2[si]
	mov u_initcs,ax ! pop es
	mov bx,offset idlepd		;IDLE
	mov ax,p_uda[bx]
	add ax,cs:sysdat		;bare form wrong, same bug class/fix as above
	push es ! mov es,ax
	mov si,offset supervisor
	mov ax,cs:2[si]
	mov u_initcs,ax ! pop es
	push ax ! push bx ! mov bx,28h ! mov ax,[bx] ! call ydbg ! pop bx ! pop ax	;TEMP DEBUG PROBE
	mov dx,bx ! call proc_creat
	push ax ! push bx ! mov bx,28h ! mov ax,[bx] ! call ydbg ! pop bx ! pop ax	;TEMP DEBUG PROBE
		;init is now a process and can run
		;concurrently with idle process
	retf

;TEMP DEBUG PROBE
ydbg:
	push ax ! push bx ! push cx ! push dx
	mov cx,0404h
ydbg1:	rol ax,cl
	mov bl,al ! and bl,0fh ! cmp bl,9
	ja ydbg2
	add bl,'0' ! jmp ydbg3
ydbg2:	add bl,'A'-10
ydbg3:	mov dx,03f8h ! push ax ! mov al,bl ! out dx,al ! pop ax
	dec ch ! jnz ydbg1
	mov al,' ' ! mov dx,03f8h ! out dx,al
	pop dx ! pop cx ! pop bx ! pop ax
	ret

;*****************************************************
;*
;*	RTM Function Table
;*
;*****************************************************

function	dw	sysreset_entry	;0
		dw	poll_entry	;1
		dw	flag_wait_entry	;2
		dw	flag_set_entry	;3
		dw	makeq_entry	;4
		dw	openq_entry	;5
		dw	deleteq_entry	;6
		dw	readq_entry	;7
		dw	creadq_entry	;8-conditional readq
		dw	writeq_entry	;9
		dw	cwriteq_entry	;10-conditional writeq
		dw	delay_entry	;11
		dw	dispatch_entry	;12
		dw	terminate_entry	;13
		dw	creat_proc_entry;14
		dw	set_prior_entry	;15
		dw	pd_entry	;16-get PD address
		dw	abort_spec_entry;17-abort process
		dw	sleep_entry	;18
		dw	wakeup_entry	;19
		dw	findpdname_entry;20

;=====		=================
entry:		; RTM Entry Point
;=====		=================
	push ax ! push dx ! mov al,'V' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	mov ch,0 ! shl cx,1 ! mov si,cx
	push dx ! mov al,10h ! mov dx,03f8h ! out dx,al ! mov ax,si ! call ydbg ! pop dx	;TEMP DEBUG PROBE: marker 10h, dump SI (table index*2, should be 28/1Ch for creat_proc_entry) right before RTM's own internal "call cs:function[si]" -- #49's own next step, to see whether RTM's table lookup is already wrong by the time it gets here, or whether creat_proc_entry itself does something that bounces back out to SUPIF's gofar
	call cs:function[si]
rtm_ret:
	push ax ! push dx ! mov al,'W' ! mov dx,03f8h ! out dx,al ! mov ax,ds ! call ydbg ! pop dx ! pop ax	;TEMP DEBUG PROBE: now also dumps DS at every RTM call return
	retf

;=====		===============
mpmif:		; MPM Interface
;=====		===============
	callf cs:dword ptr .supervisor ! ret

;======		================
xiosif:		; XIOS Interface
;======		================
	mov si,mod_entry
	callf dword ptr xiosmod[si] ! ret

; Standalone wrapper for src-assem/kernel/DSPTCH.RTM: fdisp, int_disp_exit,
; farpdisp/pdisp, dsptch, insert_process, schedule, switch (+ the
; whole dsp_table dispatch), bundled with src-assem/kernel/PROC.RTM for
; `freepd` (called by `term_act` as an ordinary internal call). The
; real UDA.FMT/VEC.FMT/SYSDAT.FMT are included, so every field
; resolves to its genuine offset -- the same ones src-c/kernel/
; dsptch.c uses on real memory. tests/src-c/test_dsptch.py runs this
; with tools/i86sim.py's segmented=True, a real SYSDAT segment, and
; the code relocated off segment 0 (the dispatcher saves/restores the
; real interrupt vectors there).
;
; `sysdat` is normally this module's own cs cell (`cs:sysdat`);
; declared here at cseg offset 0. `mpmif` is an unported external call
; target (term_act's detach/free calls), stubbed by address. `xiosif`
; is a real stub returning AL=0: schedule's io_polldev poll then
; reports "not ready", the same fixed result dsptch.c uses (an
; address-only stub would leave AL = io_polldev, i.e. "ready").
	include system.def
	include pd.def
	include err.def
	include mem.def
	include flg.def
	include modfunc.def
	include xioscb.def

	cseg
sysdat	dw	0
mpmif	equ	9000h
	include dsptch.rtm
	include proc.rtm
xiosif:	mov al,0 ! ret

	include uda.fmt
	include vec.fmt
	include sysdat.fmt
	end

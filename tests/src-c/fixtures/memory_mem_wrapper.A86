; Standalone wrapper for src/kernel/MEMORY.MEM's malloc_entry, mfree_entry
; (+ internal mfree_it), and mall_try_mau. Unlike MAU.MEM/SHARE.MEM, none
; of these switch DS to a dynamically-computed segment and then use a
; fixed offset relative to it -- they only use the already-established
; u_wrkseg/cs:sysdat patterns, so no new addressing gap applies here.
; getmd/freemd (src/kernel/UTIL.MEM, already ported in util_mem.c) are
; called as ordinary internal calls below, not boundary stubs.
;
; `rlr`/`thrdrt`/`mal`/`mfl`/`mdul` are DSEG labels at the scratch
; addresses src-c/kernel/defs.h and tests/src-c/test_memory_mem.py both
; use (see idle_wrapper.A86's comment for why, same reasoning as there).
	include system.def
	include pd.def
	include err.def
	include mem.def
	include mpb.def
	include modtab.def
	include modfunc.def
	dseg
	org	0A000h
rlr		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A028h
mdul		dw	0
mal		dw	0
mfl		dw	0
	org	0A032h
thrdrt		dw	0
	cseg
sysdat	dw	0		; normally supplied by this module's own init
; mpmif: a real dispatcher now, not a flat stub, for the two function
; codes malloc_entry's own mall_try_mau/mall_ml genuinely need for
; real (f_maualloc/f_mlalloc -- see src-c/kernel/memory.c's own header
; comment for why): tail-jumps into the real MAU.MEM/ML.MEM entry
; points bundled below, whose own "ret" returns straight to mpmif's
; own caller, exactly like the real dispatcher would. Every other
; function code (f_maufree, still unported for real -- same header
; comment) falls through to a plain no-op ret, same as every other
; boundary stub in this tree.
mpmif:
	cmp cx,f_maualloc ! je mpmif_maualloc
	cmp cx,f_mlalloc ! je mpmif_mlalloc
	ret
mpmif_maualloc:	jmp maualloc_entry
mpmif_mlalloc:	jmp mlalloc_entry
	include util.mem
	include memory.mem
	include mau.mem
	include ml.mem
	end

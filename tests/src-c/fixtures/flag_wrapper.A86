; Standalone wrapper for src/kernel/FLAG.RTM: flag_set_entry, flag_wait_entry,
; and their shared internal helpers flag_valid/flag_exit/flag_bexit (all in
; this one file, ported as ordinary internal C calls -- no stub needed for
; those). flag_wait_entry's `fw_non` path calls the dispatcher (`call
; dsptch`); per docs/src-c.md's boundary-stub convention that's a
; `call_stub_addrs` entry (an instant no-op return is correct here: nothing
; downstream reads a register the dispatcher might have set).
;
; The real UDA.FMT/SYSDAT.FMT are included, so `rlr`/`drl`/`nflags`/
; `flags`/`u_dparam` resolve to their genuine offsets -- the same ones
; src-c/kernel/flag.c uses on real memory.
	include system.def
	include pd.def
	include flg.def
	include err.def

	cseg
dsptch	equ	9000h
	include flag.rtm

	include uda.fmt
	include sysdat.fmt
	end

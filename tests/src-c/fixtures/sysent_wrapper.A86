; Standalone wrapper for 7 of src-assem/kernel/SYSENT.RTM's 8 entries: poll_entry,
; delay_entry, dispatch_entry, set_prior_entry, pd_entry, sleep_entry,
; wakeup_entry. `creat_proc_entry` has its own wrapper,
; creat_proc_wrapper.A86 (it really calls proc_creat/pdisp).
;
; Every routine here either tail-jumps into the dispatcher (`dsptch`/
; `pdisp`) or, in wakeup_entry's case, calls it mid-routine and keeps
; going. Per docs/src-c.md's boundary-stub convention those targets are
; plain addresses: tests/src-c/test_sysent.py stops the simulator there.
;
; The real UDA.FMT/SYSDAT.FMT are included, so `rlr`/`drl`/`u_dparam`/
; `u_retseg` resolve to their genuine offsets -- the same ones
; src-c/kernel/sysent.c uses on real memory.
	include system.def
	include pd.def

	cseg
dsptch	equ	9000h
pdisp	equ	9010h
proc_creat equ	9020h
	include sysent.rtm

	include uda.fmt
	include sysdat.fmt
	end

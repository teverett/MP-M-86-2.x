; Standalone wrapper for src/kernel/MEMIF.MEM's `entry` (the module's
; own inter-module MEM dispatch, with its real binary-semaphore
; acquire/release around it), together with the real CPMMEM.MEM,
; MEMORY.MEM, SHARE.MEM, MAU.MEM, and ML.MEM its own `functab`
; dispatches into -- same combination src/kernel/MEM.A86 itself
; assembles (minus UTIL.MEM, not needed by any of `entry`'s own 13
; targets).
;
; Reuses tests/src-c/fixtures/cpmmem_wrapper.A86's own scratch-address
; conventions (`rlr`/`u_wrkseg`/`mdul`/`mal`/`mfl`/`thrdrt`), plus two
; more this file's own `entry` needs: `mxmemowner`/`mxmemcount`
; (src-c/kernel/defs.h's own SD_MXMEMOWNER/SD_MXMEMCOUNT, already used
; by abort.c/dsptch.c) and `mxmemqpb` (SD_MXMEMQPB, new).
;
; Unlike cpmmem_wrapper.A86 (which has no MEMIF.MEM and so builds its
; own smart `mpmif:` dispatcher routing f_malloc/f_maualloc/etc. back
; into malloc_entry/maualloc_entry/etc., simulating the real round
; trip through the Supervisor), this wrapper DOES include MEMIF.MEM,
; which declares `mpmif`/`xiosif` as real labels of its own (`callf
; cs:dword ptr .supervisor!ret` / `callf dword ptr .xiosmod!ret`).
; test_memif_entry.py treats those real addresses as plain no-op
; near-call boundary stubs instead (same convention
; test_cioif_entry.py's own wrapper uses for CIOIF.CIO's `mpmif`/
; `xiosif`) -- meaning every OTHER target's own internal `mpmif` calls
; (cpmalloc_entry's own f_malloc, etc.) are no-ops here too. That's
; deliberate: this test verifies `entry`'s own dispatch+mutex wiring,
; not each target's full internal behavior, which test_cpmmem.py/
; test_memory.py/etc. already cover with their own smarter stand-ins.
	include system.def
	include pd.def
	include err.def
	include mem.def
	include mpb.def
	include modtab.def
	include modfunc.def
	dseg
	org	0A000h
rlr		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A028h
mdul		dw	0
mal		dw	0
mfl		dw	0
	org	0A032h
thrdrt		dw	0
	org	0A03Ah
mxmemowner	dw	0
mxmemcount	db	0
	org	0B500h
mxmemqpb	rb	16
	org	0A88Dh
supmod		rw	2	; SYSDAT's own module_table[sup] far pointer --
				; init copies this into MEMIF.MEM's own local
				; `supervisor` cell (not otherwise touched here)
	org	0A8A0h
xiosmod		rw	2	; only xiosif's own `.xiosmod` dot-reference
				; needs this to exist to assemble
	cseg
sysdat	dw	0		; normally supplied by MEMIF.MEM's own init
	include memif.mem
	include cpmmem.mem
	include memory.mem
	include share.mem
	include mau.mem
	include ml.mem
	include util.mem
	end

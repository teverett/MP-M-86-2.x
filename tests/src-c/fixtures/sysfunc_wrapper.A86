; Standalone wrapper for all 8 entries in src/kernel/SYSFUNC.SUP:
; not_implemented, bad_entry, version_entry, mpmversion_entry,
; callbios_entry, sysdat_entry, tod_entry, serial_entry.
;
; `vernum`/`mpmvernum`/`tod` normally come from SYSDAT.FMT; declared
; here as DSEG labels at the harness-chosen scratch addresses
; src-c/kernel/defs.h and tests/src-c/test_sysfunc.py both use (see
; idle_wrapper.A86's own comment for why a plain EQU would be wrong
; for a value that's read, not jumped to). `rlr`/`u_wrkseg`/
; `u_retseg` are the same.
;
; `serial` is RTMIF.RTM's own real, literal `db '654321'` cseg
; constant (see src-c/kernel/sysfunc.c's own header comment) --
; declared here exactly as that file does, not a placeholder.
;
; `mpmif`/`xiosif` are boundary-stub targets, same convention as
; every other file's own unported-call stubs: `callbios_entry`'s own
; BOOT/WBOOT path tail-jumps into `mpmif(f_terminate)` with nothing
; further to check (same class as CPMMEM.MEM's own `freeall_entry`),
; and its other tail-jump path (into `xiosif`) is a `stop_addrs`
; checkpoint -- the test checks the register state right there, same
; convention as SYSENT.RTM's own already-ported `poll_entry`/
; `delay_entry`/etc.
	include system.def
	include pd.def
	include err.def
	include modtab.def
	include modfunc.def
	dseg
	org	0A000h
rlr		dw	0
	org	0A00Ah
vernum		dw	0
mpmvernum	dw	0
	org	0A010h
u_dparam	dw	0
u_wrkseg	dw	0
u_retseg	dw	0
	org	0A049h
tod		dw	0
tod_hr		db	0
tod_min		db	0
tod_sec		db	0
	cseg
mpmif	equ	9000h		; unported external call target (stub)
xiosif	equ	9010h		; ditto
serial	db	'654321'
	include sysfunc.sup
	end

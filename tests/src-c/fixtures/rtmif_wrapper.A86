; Standalone wrapper for src-assem/kernel/RTMIF.RTM's `init`, laid out like
; the real RTM module: RTMIF.RTM at the start of the code segment (org
; 0, so `sysdat`/`supervisor` sit at their real offsets 6/8), and the
; real UDA.FMT/VEC.FMT/SYSDAT.FMT included so `supmod`/`dispatcher`/
; `rtm_pdisp`/`tickpd`/`idlepd`/`u_initcs`/`u_initss` resolve to their
; genuine offsets, the same ones src-c/kernel/rtmif.c uses.
; tests/src-c/test_rtmif.py runs this with tools/i86sim.py's
; segmented=True and a real nonzero SYSDAT segment.
;
; `entry` (RTMIF.RTM's own inter-module dispatch) isn't executed by
; this test; its function-table targets are bare markers so the file
; assembles as the complete module. `fdisp`/`farpdisp` are only taken
; by offset.
;
; The real PROC.RTM is linked in, so `init`'s closing `call
; proc_creat` really creates the tick and idle processes on both sides
; (proc.c runs on real memory too).
	include system.def
	include pd.def
	include err.def
	include mem.def
	include modfunc.def
	include modtab.def

	cseg
	include rtmif.rtm
	include proc.rtm
fdisp:			ret
farpdisp:		ret
sysreset_entry:		ret
poll_entry:		ret
flag_wait_entry:	ret
flag_set_entry:		ret
makeq_entry:		ret
openq_entry:		ret
deleteq_entry:		ret
readq_entry:		ret
creadq_entry:		ret
writeq_entry:		ret
cwriteq_entry:		ret
delay_entry:		ret
dispatch_entry:		ret
terminate_entry:	ret
creat_proc_entry:	ret
set_prior_entry:	ret
pd_entry:		ret
abort_spec_entry:	ret
sleep_entry:		ret
wakeup_entry:		ret
findpdname_entry:	ret
mod_entry:		ret

	include uda.fmt
	include vec.fmt
	include sysdat.fmt
	end

; Wrapper for src-assem/kernel/SYSENT.RTM's `creat_proc_entry` (`call
; proc_creat ! jmp pdisp`) run all the way through for real: bundles
; the real SYSENT.RTM, DSPTCH.RTM and PROC.RTM, plus the real UDA.FMT/
; VEC.FMT/SYSDAT.FMT so every field resolves to its genuine offset.
; tests/src-c/test_sysent.py runs it with segmented=True, a real SYSDAT
; segment, and the code relocated off segment 0 (the dispatcher and
; proc_creat touch the real interrupt vectors there).
;
; `sysdat` is normally RTMIF.RTM's own cs cell; declared here at cseg
; offset 0. `mpmif` is stubbed by address; `xiosif` is a real stub
; returning AL=0 (poll "not ready", matching dsptch.c -- see
; dsptch_wrapper.A86).
	include system.def
	include pd.def
	include err.def
	include mem.def
	include flg.def
	include modfunc.def
	include xioscb.def

	cseg
sysdat	dw	0
mpmif	equ	9000h
	include sysent.rtm
	include dsptch.rtm
	include proc.rtm
xiosif:	mov al,0 ! ret

	include uda.fmt
	include vec.fmt
	include sysdat.fmt
	end

; Standalone wrapper for src/kernel/IDLE.SUP's `idle:` routine.
;
; `rlr` normally comes from SYSDAT.FMT (a fixed offset within the real
; System Data Area segment). This test harness models memory as one flat
; 64KB array with no real segment registers (see tools/i86sim.py's
; docstring), so SYSDAT's real small offset -- which only makes sense
; relative to its OWN segment base on real hardware -- would collide with
; this routine's own code if included as-is (`include sysdat.fmt`). Instead
; `rlr` is declared here as a DSEG label at a harness-chosen scratch
; address (0A000h, consistent with tests/src-c/test_idle.py) so the
; assembler still encodes a real memory read (`mov bx,rlr`), not an
; immediate load -- an EQU constant would assemble to the wrong opcode
; shape entirely. `xiosif` IS a plain EQU, correctly: it's only ever used
; as a JMP target, never read as data, so a bare numeric address is exactly
; what a label would resolve to anyway. It's a stub address
; tests/src-c/test_idle.py recognizes as a JMP-boundary (see
; tools/i86sim.py's `stop_addrs`).
	include system.def
	include pd.def
	include xioscb.def
xiosif	equ	9000h
	dseg
	org	0A000h
rlr	dw	0
	cseg
sysdat	dw	0		; normally supplied by SUPIF.SUP's own init
	include idle.sup
	end

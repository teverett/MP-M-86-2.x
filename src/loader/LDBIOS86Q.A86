;*****************************************************
;*
;*	L D B I O S 8 6 Q  -  a new LDBIOS for the MP/M-86 loader
;*	under QEMU
;*	=========================================================
;*
;*	Not DRI source. Written for this project, replacing the
;*	real LDBIOS.A86's "LDBIOS for LDMPM Configured for iSBC
;*	86/12 with the iSBC 204 Floppy Disk Controller" (its own
;*	title line) the same way src/kernel/XIOS86Q.A86 replaces
;*	XIOS.A86 -- same QEMU target (standard PC UART @ 03F8h for
;*	the console, standard PC floppy controller, NEC 765/8272,
;*	@ 03F0h for disk, PIO, no DMA), and in fact the exact same
;*	NEC765/UART driver *code* (lightly adapted for this file's
;*	own register conventions -- see below), not just the same
;*	design: there was no reason to re-derive and re-review it
;*	twice. See XIOS86Q.A86's own header comment for the design
;*	rationale and limitations that carry over unchanged.
;*
;*	LDBIOS.A86's own calling convention is the classic CP/M
;*	BIOS jump-vector table (INIT/WBOOT/CONST/CONIN/CONOUT/...
;*	at fixed, sequential 3-byte-apart offsets from the start of
;*	the file) confirmed against LDBDOS.A86's own include chain
;*	and against the real LDBIOS.A86 itself -- a different
;*	convention from XIOS's AL-dispatched function table, with
;*	a few per-function register differences (SELDSK returns the
;*	DPH address in BX here, not AX), kept identical to the real
;*	LDBIOS.A86 for compatibility with LDBDOS.A86, which this file
;*	does not change at all.
;*
;*	INIT is reached via a plain near JMP, not a CALL (see
;*	LDMPM.A86's own "jmp mldbios ... mldbios returns here: 103H"
;*	comment, and the real LDBIOS.A86's own "jmp INIT ;Enter from
;*	BOOT ROM or LOADER") -- so it must hand control back the same
;*	way, with another JMP to a hardcoded address, not a RET (which
;*	would pop whatever happens to be on the stack instead, since
;*	nothing pushed a real return address). The real LDBIOS.A86 does
;*	exactly this: `ccp_offset equ 0103h ;base of MPMLOADER` /
;*	`jmp ccp` -- confirmed by testing this file for real in QEMU
;*	before this fix: everything up through the loader's own
;*	"jump into MPMLDR" message worked, then nothing, because INIT's
;*	own "ret" was landing on garbage. WBOOT (real LDBIOS.A86:
;*	`jmp ccp+6`, a different, warm-boot-specific LDMPM entry point)
;*	is simplified here to the same target -- it isn't on this
;*	loader's own cold-boot path, and pinning down LDMPM.A86's exact
;*	byte offset for that second entry point isn't worth it yet.
;*
;*	That fix alone wasn't enough, though -- another real bug,
;*	caught the same way: a plain `jmp ccp_offset` is a *relative*
;*	near jump, encoded assuming this module assembles starting at
;*	address 0. The real LDBIOS.A86 can get away with a relative
;*	jump to its own "ccp" label because it's declared (via `org
;*	ccp_offset`) within the SAME single-pass assembly as the jump
;*	that targets it, so the assembler computes a correct
;*	displacement no matter how far apart the two end up in the
;*	final image. This file used to be assembled from `org 0`
;*	(a separate, independent module only concatenated into
;*	MPMLDR.bin afterwards, by tools/build_mpmldr.py) -- a relative
;*	jump computed against address 0 was wrong once relocated to
;*	wherever this module actually landed (`mldbios_offset`), landing
;*	at `mldbios_offset + 0x103` instead of the real, absolute 0x103.
;*
;*	That `org 0` problem turned out to be pervasive, not unique to
;*	this one jump: *every* `offset <label>` in this file referencing
;*	its own local data (`offset stkbase`, `offset secbuf`, `offset
;*	specify_parms`, the DPB/DPE, the UART/FDC scratch cells...) was
;*	wrong the same way, baking in an address relative to this
;*	module's own `org 0` instead of its real position
;*	(`mldbios_offset`) in the concatenated MPMLDR.bin. Confirmed by
;*	testing in QEMU: boot got past the loader's own "jump into
;*	MPMLDR" message and ran INIT's hardware setup (I/O port writes
;*	don't care about addressing), but then `mov sp,offset stkbase`
;*	pointed SP ~0xe97 bytes too low -- into LDMPM's own code -- so
;*	INIT's own PUSHes overwrote LDMPM, corrupting the very ccp_offset
;*	(0x103) landing site before the final jump back there. That's
;*	also why this file used to declare its data in a separate `dseg`
;*	(now removed, merged into `cseg` below): tools/build_mpmldr.py
;*	only ever copied each module's `.cseg.bin`, so that whole dseg --
;*	the signon string, DPB, FDC command tables, `secbuf`, the boot
;*	stack -- was silently dropped from MPMLDR.bin entirely, on top of
;*	the addressing bug above.
;*
;*	Both problems share the one real fix: this module's `cseg` now
;*	starts with `org mldbios_offset` (a local copy of LDMPM.A86's own
;*	constant, kept in sync by tools/build_mpmldr.py the same way)
;*	instead of `org 0`, so every `offset <label>` -- and every plain
;*	`jmp <label-outside-this-module>` -- the assembler computes is
;*	already correct against the real, final, absolute position, with
;*	no per-reference fixup needed. (An earlier version of this fix
;*	tried an indirect `mov ax,ccp_offset ! jmp ax` for just the one
;*	cross-module jump, before the `org` fix made it unnecessary --
;*	dropped because, confirmed via testing, register-indirect `jmp`
;*	reliably failed to transfer control at all on this specific QEMU
;*	target for reasons never root-caused; a plain direct `jmp
;*	ccp_offset` here, now that it assembles to the correct
;*	displacement, sidesteps whatever that was.) tools/build_mpmldr.py
;*	strips the resulting leading `mldbios_offset` zero-padding bytes
;*	(asm86 pads a raw binary from 0 up to any `org` target) before
;*	concatenating this module's real content, the same trick
;*	LDBDOS.A86's own bdosoffset fix avoided needing by zeroing itself
;*	instead -- not an option here since mldbios_offset is this
;*	file's one genuine absolute position, not a vestigial DRI
;*	constant.
;*
;*	KNOWN LIMITATIONS (also see XIOS86Q.A86's own, which this
;*	inherits in full for the shared disk/console driver code):
;*	  - Only one drive (disk 0); the real LDBIOS.A86 supported
;*	    two. SELDSK returns 0 (invalid) for any other drive.
;*	  - The one DPB/DPE below is a complete, self-consistent
;*	    geometry for the same 80-cylinder/2-head/18-sector(512B)/
;*	    4:1-deblocked floppy XIOS86Q.A86 targets (SPT=72 128-byte
;*	    records/track, 8192-byte blocks, DSM=176, 64 directory
;*	    entries) -- but nothing has actually formatted a disk
;*	    image to this geometry yet, and LDBDOS.A86's own
;*	    directory-search logic that uses this DPB to find
;*	    "MPM.SYS" has not been exercised at all (same "assembles,
;*	    never executed" caveat as everything else built this way).
;*
;*****************************************************

true		equ -1
false		equ not true
ccp_offset	equ 0103h	;base of MPMLDR -- see the real LDBIOS.A86's
				; own identical EQU; INIT/WBOOT JMP back
				; here (a plain direct JMP -- see this
				; file's header comment), they aren't CALLed
mldbios_offset	equ 1113h	;this module's own real position in the
				; concatenated MPMLDR.bin -- local copy of
				; LDMPM.A86's own constant of the same name,
				; self-corrected by tools/build_mpmldr.py;
				; see this file's header comment on why its
				; `cseg` is `org`'d here instead of at 0
cr		equ	0dh
lf		equ	0ah

;*****************************************************
;*	UART (8250/16450) EQUATES -- COM1, polled, 9600 8N1
;*	(identical to XIOS86Q.A86's own -- see its comments)
;*****************************************************

uart_base	equ	03f8h
uart_rxtx	equ	uart_base+0
uart_ier	equ	uart_base+1
uart_lcr	equ	uart_base+3
uart_mcr	equ	uart_base+4
uart_lsr	equ	uart_base+5
uart_lsr_rxrdy	equ	01h
uart_lsr_txrdy	equ	20h
uart_divisor	equ	000ch

;*****************************************************
;*	FLOPPY (NEC 765/8272) EQUATES -- identical to
;*	XIOS86Q.A86's own
;*****************************************************

fdc_base	equ	03f0h
fdc_dor		equ	fdc_base+2
fdc_msr		equ	fdc_base+4
fdc_data	equ	fdc_base+5
fdc_ccr		equ	fdc_base+7
msr_rqm		equ	80h
msr_dio		equ	40h
msr_busy	equ	10h
dor_mota	equ	10h
dor_ndreset	equ	04h
dor_dmaen	equ	08h
dor_drvsel_a	equ	00h
cmd_specify	equ	03h
cmd_recal	equ	07h
cmd_sense_int	equ	08h
cmd_seek	equ	0fh
cmd_read	equ	46h
cmd_write	equ	45h
fd_heads	equ	2
fd_spt		equ	18
fd_secsize_n	equ	2
fd_secsize	equ	512
fd_gap3		equ	01bh
fd_dtl		equ	0ffh

;*****************************************************
;*	8237 DMA (channel 2, the ISA floppy channel)
;*	EQUATES -- see dma_setup's own comment for why
;*	this driver needs these at all now.
;*****************************************************

dma_addr2	equ	04h	;channel 2 current-address register
dma_count2	equ	05h	;channel 2 current-count register
dma_page2	equ	81h	;channel 2 page register (addr bits 16-23)
				; -- fixed ISA wiring, not simply "0x80+
				; channel"; ch0/1/2/3 page ports are
				; 87h/83h/81h/82h respectively
dma_mask	equ	0ah	;single-channel mask set/clear register
dma_mode	equ	0bh	;mode register
dma_clrff	equ	0ch	;clear first/last flip-flop (write any value)
dma_mask_set2	equ	06h	;mask channel 2 (bit2=set, bits1-0=channel)
dma_mask_clr2	equ	02h	;unmask channel 2
dma_mode_read	equ	46h	;single/increment/no-autoinit/"write to
				; memory" (disk->RAM, for a floppy READ)/
				; channel 2
dma_mode_write	equ	4ah	;single/increment/no-autoinit/"read from
				; memory" (RAM->disk, for a floppy WRITE)/
				; channel 2

	cseg
	org	mldbios_offset	;see header comment -- NOT org 0

;*********************************************
;*                                           *
;* BIOS Jump Vector for Individual Routines  *
;* -- same fixed order as the real LDBIOS.A86*
;*                                           *
;*********************************************

	jmp	INIT
	jmp	WBOOT
	jmp	CONST
	jmp	CONIN
	jmp	CONOUT
	jmp	LISTOUT
	jmp	PUNCH
	jmp	READER
	jmp	HOME
	jmp	SELDSK
	jmp	SETTRK
	jmp	SETSEC
	jmp	SETDMA
	jmp	READ
	jmp	WRITE
	jmp	LISTST
	jmp	SECTRAN
	jmp	SETDMAB
	jmp	GETSEGT
	jmp	GETIOBF
	jmp	SETIOBF

;*********************************************
;*	INIT -- arm the hardware, then jump back into LDMPM.A86 at
;*	ccp_offset (see this file's own header comment for why that's
;*	an indirect jump, not a plain relative one).
;*********************************************

INIT:
	cli			; ROM86Q.A86's own boot sector STIs right
				; after setting up SS:SP, leaving interrupts
				; enabled all the way into here -- so IRQ6
				; (floppy) was unmasked and still vectored
				; through SeaBIOS's own INT 0Eh handler the
				; whole time this code was doing raw FDC
				; port I/O behind that handler's back.
				; Confirmed via GDB: the FDC hang
				; (docs/bugs.md #15) wasn't this file's own
				; polling loop spinning forever -- CS:IP was
				; sitting inside SeaBIOS itself (CS=F000h),
				; stuck in whatever it does for an IRQ6 it
				; received while BIOS's own idea of the
				; controller's state didn't match ours
				; anymore. This driver is purely polled and
				; never needs interrupts delivered at all, so
				; just keep them off for good instead of
				; only masking IRQ6 -- nothing from here on
				; (console or disk) depends on STI.
	mov	ax,cs
	mov	ss,ax ! mov ds,ax ! mov es,ax
	mov	sp,offset stkbase
	cld

	mov	al,80h ! mov dx,uart_lcr ! out dx,al
	mov	ax,uart_divisor
	mov	dx,uart_rxtx ! out dx,al
	mov	al,ah ! mov dx,uart_ier ! out dx,al
	mov	al,03h ! mov dx,uart_lcr ! out dx,al
	mov	al,0 ! mov dx,uart_ier ! out dx,al
	mov	al,03h ! mov dx,uart_mcr ! out dx,al

	mov	al,dor_ndreset+dor_mota+dor_dmaen+dor_drvsel_a
	mov	dx,fdc_dor ! out dx,al
				; NOT a reset pulse -- SeaBIOS's own INT 13h
				; floppy driver already reset/initialized
				; this controller for real during the boot
				; sector's own reads (see ROM86Q.A86's
				; read_sector, which goes through INT 13h,
				; not raw ports): confirmed via GDB that a
				; DOR write with NDRESET toggled 0 then 1
				; here, to force a *synthetic* reset edge,
				; left QEMU's emulated 8272 with no genuine
				; pending interrupt to report, so the
				; previous fix's own SENSE INTERRUPT STATUS
				; drain loop (docs/bugs.md #15) hung forever
				; polling fdc_in_byte for a result byte that
				; QEMU's model never produces for a SIS it
				; doesn't recognize as answering a real
				; interrupt -- it just silently drops back to
				; idle (MSR RQM=1,DIO=0, "ready for a new
				; command") instead of entering the result
				; phase at all. Just re-asserting the
				; already-working motor/DMA-enable/drive-
				; select state (no edge, no synthetic reset,
				; no SIS needed) leaves the controller in the
				; same real, working state the boot sector's
				; own reads just proved functional.

	mov	bx,offset specify_parms
	call	fdc_send_cmd

	jmp	ccp_offset		;a plain direct JMP -- correct now that
				; this module's own `org` makes the
				; assembler compute the right displacement;
				; see this file's header comment

WBOOT:
	jmp	ccp_offset

;*********************************************
;*	CONSOLE I/O -- same UART driver as
;*	XIOS86Q.A86's const/conin/conout
;*********************************************

CONST:
	mov	dx,uart_lsr ! in al,dx
	and	al,uart_lsr_rxrdy
	mov	ah,0 ! jz const_nrdy
	mov	al,0ffh
const_nrdy:
	ret

CONIN:
cin_wait:
	call	CONST ! jz cin_wait
	mov	dx,uart_rxtx ! in al,dx
	ret

CONOUT:
cout_wait:
	mov	dx,uart_lsr ! in al,dx
	and	al,uart_lsr_txrdy
	jz	cout_wait
	mov	al,cl
	mov	dx,uart_rxtx ! out dx,al
	ret

LISTOUT:
LISTST:
	ret

PUNCH:
READER:
	mov	al,1ah
	ret

GETIOBF:
	xor	al,al
	ret

SETIOBF:
	ret

;	utility: print a null-terminated message at BX

pmsg:
	mov	al,[bx]
	or	al,al ! jz pmsg_done
	mov	cl,al
	call	CONOUT
	inc	bx
	jmps	pmsg
pmsg_done:
	ret

;*********************************************
;*	DISK I/O -- SELDSK/HOME/SETTRK/SETSEC/
;*	SETDMA/SETDMAB/SECTRAN/GETSEGT match the
;*	real LDBIOS.A86's own register conventions
;*	exactly (SELDSK returns the DPH address in
;*	BX, not AX, unlike XIOS86Q's SELDSK); the
;*	actual transfer mechanics (fdc_* below) are
;*	XIOS86Q.A86's own floppy driver verbatim.
;*********************************************

SELDSK:
	xor	bx,bx
	cmp	cl,0 ! jne return
	mov	disk,0
	mov	bx,offset dpe0
return:
	ret

HOME:
	mov	trk,0
	mov	bx,offset recal_parms
	call	fdc_send_cmd
	call	fdc_wait_seek
	ret

SETTRK:
	mov	trk,cl
	ret

SETSEC:
	mov	sect,cl
	ret

SECTRAN:
	cmp	dx,0 ! jne sectran1
	    mov	ax,cx ! ret
sectran1:
	mov	bx,cx ! add bx,dx
	mov	bl,[bx] ! xor bh,bh
	mov	ax,bx
	ret

SETDMA:
	mov	dma_adr,cx
	ret

SETDMAB:
	mov	dma_seg,cx
	ret

GETSEGT:
	mov	bx,offset segtable
	ret

READ:
	call	rw_physical
	call	fdc_seek_to
	call	fdc_fill_rw_parms
	call	dma_setup_read		;arm the 8237 before the command that
					; triggers execution phase -- see
					; dma_setup's own comment
	mov	bx,offset read_parms
	call	fdc_send_cmd
	call	fdc_pio_in		;drains READ DATA's own 7-byte result
					; phase -- no separate SENSE
					; INTERRUPT STATUS call after this:
					; confirmed via testing that QEMU
					; hangs on one here (see docs/bugs.md
					; #16's identical finding for a
					; different call site) since there's
					; no genuine pending interrupt for it
					; to report -- the result phase this
					; command just finished already is
					; this command's real status
	push	si ! push di ! push ds ! push es
	mov	si,offset secbuf ! add si,cur_bufoff
	push	cs ! pop ds
	mov	di,dma_adr ! mov es,dma_seg
	mov	cx,128 ! rep movsb
	pop	es ! pop ds ! pop di ! pop si
	xor	al,al
	ret

WRITE:
	call	rw_physical
	call	fdc_seek_to
	call	fdc_fill_rw_parms
	call	dma_setup_read		;read-modify-write: read the other
					; 3/4 of this sector first (see
					; dma_setup's own comment)
	mov	bx,offset read_parms
	call	fdc_send_cmd
	call	fdc_pio_in		;no SENSE INTERRUPT STATUS after
					; this -- see READ's own comment
	push	si ! push di ! push ds ! push es
	mov	di,offset secbuf ! add di,cur_bufoff
	mov	si,dma_adr ! push cs ! pop es
	mov	ds,dma_seg
	mov	cx,128 ! rep movsb
	pop	es ! pop ds ! pop di ! pop si
	call	fdc_fill_rw_parms
	call	dma_setup_write		;now the real write, modified
					; secbuf back out to disk
	mov	bx,offset write_parms
	call	fdc_send_cmd
	call	fdc_pio_in		;same routine now, and likewise no
					; SENSE INTERRUPT STATUS after it --
					; see READ's own comment
	xor	al,al
	ret

;*********************************************
;*	FLOPPY CONTROLLER DRIVER -- verbatim from
;*	XIOS86Q.A86 (see that file's own comments
;*	on each routine); only HOME/READ/WRITE
;*	above call into this differently, to match
;*	LDBIOS.A86's own entry points.
;*********************************************

motor_delay:
	mov	cx,0
	mov	dx,fdc_msr
md_loop:
	    in	al,dx
	    loop	md_loop
	ret

rw_physical:
	mov	al,sect			;0-based logical sector within this
					; CP/M track -- confirmed by reading
					; LBDOSF1.A86's own `seek` (real,
					; unmodified DRI source): it passes
					; SETSEC the raw `DX` remainder from
					; `div sectpt` (0..SPT-1), with no
					; +1 anywhere. This file used to
					; `dec al` here first, assuming the
					; opposite (1-based) convention --
					; wrong, confirmed by testing in
					; QEMU: every physical sector number
					; came out exactly one 128-byte
					; logical record too low, so a
					; directory-adjacent-but-still-valid-
					; looking read silently succeeded
					; while finding `MPM.SYS` (reading
					; from one record into the directory
					; area instead of the right one), but
					; `MPM.SYS`'s own first data sector
					; landed squarely in the *tail* of
					; the reserved directory block
					; instead -- all zero/E5 bytes, the
					; exact "Bad Header Record" symptom.
	mov	ah,0
	mov	bl,4 ! div bl
	mov	cur_psec,al
	inc	cur_psec
	mov	bl,ah ! mov bh,0
	shl	bx,1 ! shl bx,1 ! shl bx,1 ! shl bx,1 ! shl bx,1 ! shl bx,1 ! shl bx,1
	mov	cur_bufoff,bx
	mov	al,trk
	mov	ah,0
	mov	cl,fd_heads ! div cl
	mov	cur_cyl,al
	mov	cur_head,ah
	ret

fdc_fill_rw_parms:
	mov	al,cur_head ! mov cl,2 ! shl al,cl
	mov	byte ptr read_parms+2,al
	mov	byte ptr write_parms+2,al
	mov	al,cur_cyl
	mov	byte ptr read_parms+3,al
	mov	byte ptr write_parms+3,al
	mov	al,cur_head
	mov	byte ptr read_parms+4,al
	mov	byte ptr write_parms+4,al
	mov	al,cur_psec
	mov	byte ptr read_parms+5,al
	mov	byte ptr write_parms+5,al
	ret

fdc_seek_to:
	mov	al,cur_head ! mov cl,2 ! shl al,cl
	mov	byte ptr seek_parms+2,al
	mov	al,cur_cyl
	mov	byte ptr seek_parms+3,al
	mov	bx,offset seek_parms
	call	fdc_send_cmd
	call	fdc_wait_seek
	ret

fdc_wait_seek:
	mov	cx,0
	mov	dx,fdc_msr
fws_loop:
	    in	al,dx
	    test	al,msr_busy
	    loopnz	fws_loop
	call	fdc_sense_int
	ret

fdc_sense_int:
	mov	al,cmd_sense_int
	call	fdc_out_byte
	call	fdc_in_byte
	call	fdc_in_byte
	ret

fdc_send_cmd:
	mov	cl,[bx]
	or	cl,cl ! jz fsc_done
fsc_loop:
	inc	bx
	mov	al,[bx]
	call	fdc_out_byte
	dec	cl ! jnz fsc_loop
fsc_done:
	ret

fdc_out_byte:
	mov	cs:outbyte_tmp,al
	push	dx
	mov	dx,fdc_msr
fob_wait:
	in	al,dx
	and	al,msr_rqm+msr_dio
	cmp	al,msr_rqm
	jne	fob_wait
	mov	al,cs:outbyte_tmp
	mov	dx,fdc_data ! out dx,al
	pop	dx
	ret

fdc_in_byte:
	push	dx
	mov	dx,fdc_msr
fib_wait:
	in	al,dx
	and	al,msr_rqm+msr_dio
	cmp	al,msr_rqm+msr_dio
	jne	fib_wait
	mov	dx,fdc_data ! in al,dx
	pop	dx
	ret

fdc_pio_in:			;despite the name, the actual fd_secsize
				; data bytes now move via DMA (dma_setup
				; was called before the command that
				; started this execution phase) -- the CPU
				; only needs to drain the 7-byte PIO result
				; phase every READ/WRITE DATA command ends
				; with regardless of DMA vs non-DMA mode.
				; READ and WRITE's own call sites both call
				; this same routine now (there's nothing
				; left that differs between them).
	mov	cx,7
pio_in_res:
	    call	fdc_in_byte
	    loop	pio_in_res
	ret

;*********************************************
;*	dma_setup -- arm 8237 DMA channel 2 (the ISA floppy channel)
;*	for one fd_secsize-byte transfer into/out of secbuf, before
;*	issuing a READ DATA/WRITE DATA command. Needed because pure
;*	PIO (the CPU polling fdc_in_byte/fdc_out_byte fd_secsize
;*	times, like this file used to for the whole sector, not just
;*	the result phase above) stalls after a handful of bytes on
;*	this QEMU target's NEC765/82077 emulation -- confirmed by
;*	testing: fdc_in_byte's own MSR poll (fib_wait) simply never
;*	saw RQM+DIO go ready again after the first several bytes, with
;*	or without an added delay between bytes (ruling out a timing
;*	race) -- see docs/bugs.md #22. specify_parms's own ND
;*	(non-DMA) bit is cleared to match (see its own declaration).
;*********************************************

dma_setup_read:
	mov	bl,dma_mode_read
	jmps	dma_setup

dma_setup_write:
	mov	bl,dma_mode_write

dma_setup:
	mov	al,dma_mask_set2 ! mov dx,dma_mask ! out dx,al
				;mask channel 2 off while reprogramming it
	mov	al,0 ! mov dx,dma_clrff ! out dx,al
				;clear the address/count byte-pointer
				; flip-flop -- the next write to either
				; port below is the LOW byte regardless of
				; what this channel was left at before
	mov	al,bl ! mov dx,dma_mode ! out dx,al
				;single-transfer, address-increment,
				; no-autoinit, channel 2, direction per
				; dma_setup_read/_write's own caller

	mov	ax,cs		;secbuf's physical (20-bit) address =
	mov	bx,ax		; cs*16 + offset(secbuf) -- split into a
	mov	cl,4		; 16-bit "address" (the low 16 bits) and
	shl	ax,cl		; an 8-bit "page" (bits 16-23) the 8237
	mov	cl,12		; wants as two separate registers
	shr	bx,cl
	add	ax,offset secbuf
	adc	bx,0

	mov	dx,dma_addr2
	out	dx,al		;address low byte
	mov	al,ah
	out	dx,al		;address high byte
	mov	al,bl
	mov	dx,dma_page2 ! out dx,al

	mov	ax,fd_secsize-1	;8237 count register is (bytes - 1)
	mov	dx,dma_count2
	out	dx,al		;count low byte
	mov	al,ah
	out	dx,al		;count high byte

	mov	al,dma_mask_clr2 ! mov dx,dma_mask ! out dx,al
				;unmask channel 2 -- armed and ready for
				; the FDC command about to be sent
	ret

;*********************************************
;*                                           *
;*               Data Areas                  *
;*                                           *
;*********************************************
;*	Stays in cseg (not a separate dseg) -- see this file's header
;*	comment: code and data here share one segment (DS=SS=CS), and
;*	tools/build_mpmldr.py only ever copies each module's .cseg.bin.

signon	db	cr,lf,cr,lf,'MP/M-86 Loader -- LDBIOS86Q (QEMU)',cr,lf,0

disk		db	0
trk		db	0
sect		db	0
dma_adr		dw	0
dma_seg		dw	0
cur_cyl		db	0
cur_head	db	0
cur_psec	db	0
cur_bufoff	dw	0
outbyte_tmp	db	0

specify_parms	db	3,cmd_specify,0dfh,02h
				;last byte: HLT=1 (2ms), ND=0 -- DMA mode,
				; not the non-DMA/PIO mode the original
				; 03h (ND=1) selected; see dma_setup's own
				; comment for why
recal_parms	db	2,cmd_recal,0
seek_parms	db	3,cmd_seek,0,0
read_parms	db	9,cmd_read,0,0,0,0,fd_secsize_n,fd_spt,fd_gap3,fd_dtl
write_parms	db	9,cmd_write,0,0,0,0,fd_secsize_n,fd_spt,fd_gap3,fd_dtl

secbuf		rb	fd_secsize

;	System Memory Segment Table (GETSEGT)

segtable	db	1
		dw	tpa_seg
		dw	tpa_len

;	Disk Parameter Block/Header -- 80 cyl, 2 heads, 18
;	physical (512-byte) sectors/track, 4:1 deblocked into
;	128-byte logical records: 160 CP/M "tracks" (one per
;	physical head) of 72 logical records each; 2 reserved
;	tracks; 8192-byte (64-record) allocation blocks; 64
;	directory entries (fits in block 0 alone, so AL0=80h,
;	AL1=0); DSM computed as (160-2)*72/64 - 1 = 176.

	org	((offset $)+0fh) and 0fff0h

dpe0	dw	xlt0,0000h
	dw	0000h,0000h
	dw	dirbuf,dpb0
	dw	csv0,alv0

dpb0	equ	offset $
	dw	72		;SPT
	db	6		;BSH (8192-byte blocks)
	db	63		;BLM
	db	0		;EXM
	dw	176		;DSM-1
	dw	63		;DRM-1 (64 entries)
	db	80h		;AL0
	db	0		;AL1
	dw	16		;CKS (removable disk)
	dw	2		;OFF (reserved tracks)

xlt0	equ	0		;no sector translation

alv0	rb	(176/8)+1
csv0	rb	16
dirbuf	rb	128

stkbase_area	rw	32
stkbase	equ	offset $

lastoff		equ	offset $
tpa_seg		equ	(lastoff+0400h+15) / 16
tpa_len		equ	2000h-tpa_seg

	END

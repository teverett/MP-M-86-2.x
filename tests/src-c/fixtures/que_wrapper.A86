; Standalone wrapper for src/kernel/QUE1.RTM's makeq_entry/openq_entry/
; deleteq_entry/queverify and src/kernel/QUE2.RTM's rlsmx/getqdaddr/remqd/
; qspace/qrelease. QUE1.RTM's readq_entry/creadq_entry/readq/writeq_entry/
; cwriteq_entry/writeq are deferred -- see docs/src-c.md: they retry in a
; loop after an mpmif(f_sleep) boundary call, which needs more careful
; test design than a plain boundary stub.
;
; `qlr`/`qul`/`qmau`/`endseg` are DSEG labels at the scratch addresses
; src-c/kernel/defs.h and tests/src-c/test_que.py both use (see
; idle_wrapper.A86's comment for why a plain EQU would be wrong for any of
; these -- they're all read as memory, not used as jump targets).
; `u_wrkseg` likewise (same address UDA_WRKSEG already uses elsewhere).
	include system.def
	include pd.def
	include err.def
	include qd.def
	include mpb.def
	include modtab.def
	include modfunc.def
	dseg
	org	0A000h
rlr		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A020h
qlr		dw	0
qul		dw	0
qmau		dw	0
endseg		dw	0
	cseg
sysdat	dw	0		; normally supplied by RTMIF.RTM's own init
mpmif	equ	9000h		; unported external call target (stub)
	include que1.rtm
	include que2.rtm
	end

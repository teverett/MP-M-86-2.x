
;*****************************************************
;*
;*	Dispatch Routines
;*
;*****************************************************

;=====
fdisp:
;=====
; This entry point used by interrupt routines in XIOS

	push ax ! push dx ! mov al,'z' ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE
	cli
	push ds ! mov ds,cs:sysdat	;bare form is wrong -- fdisp is entered
					;from an interrupt, with DS = whatever
					;segment the interrupted code happened
					;to have, not necessarily sysdat-ish
					;(same bug class as the dsptch/switch
					;fixes just above/below)
	cmp indisp,true ! jne do_dispatch
	    pop ds ! iret
do_dispatch:
	mov es_sav,es
	mov bx_sav,bx
	mov bx,rlr
	mov es,p_uda[bx]
	mov u_in_int,true
	pop u_ds_sav
	push ax ! push dx ! mov al,'\' ! mov dx,03f8h ! out dx,al ! mov ax,u_ds_sav ! call ydbg ! pop dx ! pop ax	;TEMP DEBUG PROBE: dump the DS being saved off (interrupted code's real DS)
	push bx
	mov bl,p_stat[bx]
	mov u_stat_sav,bl
	pop bx
	mov p_stat[bx],ps_run
	mov bx,es_sav
	mov u_es_sav,bx
	mov bx,bx_sav
	jmp dsptch
		;dispatcher will jump to here if
		; u_in_int = true.
int_disp_exit:
	mov u_in_int,false
	mov bx_sav,bx
	mov es_sav,ax
	mov bx,rlr
	mov al,u_stat_sav
	mov p_stat[bx],al
	mov ax,es_sav
	mov bx,bx_sav
	mov indisp,false
	mov ds,u_ds_sav
	push ax ! push dx ! mov al,']' ! mov dx,03f8h ! out dx,al ! mov ax,ds ! call ydbg ! pop dx ! pop ax	;TEMP DEBUG PROBE: dump DS right after restoring it from u_ds_sav
	mov es,u_es_sav
	iret

;========
farpdisp:
;========
; Intermodule pdisp (non-interrupt)

	call pdisp ! ret

;=====
pdisp:
;=====
; Call dispatcher with no special action

	push bx ! mov bx,rlr
	mov p_stat[bx],ps_run ! pop bx
	;jmp dsptch

;======
dsptch:
;======
;	The dispatch function looks like a noop to the
;	caller. All flags and registers are maintained.
;	No levels of user stack is used.
;	(jmp dispatch = ret)
;	Interrupt routines enter through fdisp.
;
;	Dispatch has two (2) arguments:
;	1. the p_stat field of the  process  descriptor
;	    determines the type of  action  to  perform
;	    for this process.
;	2. the dparam field of the uda is  an  argument
;	    to the action.
;	The main part of the dispatch routine takes the
;	currently running process off  the  Ready  list
;	and jmps to a routine which will put it on some
;	other list depending on  the  p_stat  argument.
;	The subsequent routine will then  jump  to  the
;	scheduler which will do polling of devices  and
;	move processes off the dispatch ready list onto
;	the Ready list.  The Ready List  is  maintained
;	in priority order with  round-robin  scheduling
;	of processes with equivalent  priorities.   The
;	first process on the ready list  will  then  be
;	switched in.

		; set indisp flag
	pushf ! cld ! cli
	push ax ! push dx ! mov al,'.' ! mov dx,03f8h ! out dx,al ! mov ax,ds ! call ydbg ! mov al,':' ! mov dx,03f8h ! out dx,al ! mov al,indisp ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE: dump DS and indisp at every dsptch entry
	cmp indisp,true ! jne dispin
	    popf ! ret
dispin:	push ax ! push dx ! mov al,8Dh ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE: marker 8Dh, dispin's own literal first instruction -- confirms whether control genuinely reaches here after the "." marker's "jne dispin", or jumps somewhere else entirely (chasing the func(CX=0000) seen appearing right after "." in recent traces)
	mov indisp,true
	pop u_flag_sav
		; store and switch stack
	mov u_ss,ss ! mov u_sp,sp
	mov ss,cs:sysdat ! mov sp,offset dsptchtos	;bare "sysdat" is wrong,
					;same bug class/fix as this file's other
					;already-fixed "cs:sysdat" reads above --
					;reads SYSDAT's own offset 6
					;(module_table[sup].init_seg) instead of
					;this module's own cseg cell
	sti ! cli	;same fix as SUPIF.SUP's user_entry (#56): "sti" has a
			;one-instruction delay before it takes effect, so an
			;interrupt already pending at this exact moment isn't
			;recognized until after the NEXT instruction -- "cli"
			;right after closes that window before anything can
			;land mid-register-save. Confirmed via probe (#59):
			;marker right after this "sti" never fired until this
			;fix was added.
	push ax ! push dx ! mov al,8Eh ! mov dx,03f8h ! out dx,al ! pop dx ! pop ax	;TEMP DEBUG PROBE: marker 8Eh, right after dispin's own stack-switch+sti -- confirms execution now survives it
		; save registers
		; NOTE: We will use DS instead of ES
		;  No segment overrides...
	push es ! pop ds
	mov ds:u_ax,ax
	mov ds:u_bx,bx
	mov ds:u_cx,cx
	mov ds:u_dx,dx
	mov ds:u_di,di 
	mov ds:u_si,si
	mov ds:u_bp,bp
		; save interrupt vectors
		; block move first 5
	mov bx,0 ! mov ds,bx
	mov si,bx ! mov di,offset u_ivectors
	mov cx,10 ! rep movs ax,ax
		; block move mpmint,debugint
	mov si,offset i_mpm_ip ! mov di,offset u_mpm_ip
	mov cx,4 ! rep movs ax,ax
		; take current process off RLR.
	mov ds,cs:sysdat	;bare "mov ds,sysdat" is wrong here -- DS was
				;just set to 0 a few instructions above (to
				;copy the interrupt vector table from 0:0),
				;so reading the module's own "sysdat" cache
				;cell through DS=0 picks up garbage from low
				;memory instead of the real SYSDAT segment.
				;Confirmed via GDB/serial trace: "mov si,rlr"
				;right after this read rlr back as 0E99h
				;(garbage) instead of the correct 09C0h,
				;corrupting the ready list on the very first
				;real dispatch_entry/schedule() call of the
				;session and jumping dsp_table out of bounds.
				;Same bug class as MAU.MEM's maua_out/mauf_out,
				;MEMORY.MEM's mall_ml/mall_try_mau/mfree_it,
				;and ML.MEM's mlalloc_entry tail.
	cli
	mov si,rlr
	push ax ! push dx ! mov al,11 ! mov dx,03f8h ! out dx,al ! mov ax,si ! call ydbg ! mov ax,p_link[si] ! call ydbg ! pop dx ! pop ax	;TEMP DEBUG PROBE: marker 11 (raw byte), dump si (old rlr) then p_link[si] (new rlr) at the moment it's taken off the ready list
	mov ax,p_link[si] ! mov rlr,ax
	push ax ! push bx ! push dx ! mov bx,ax ! mov al,97h ! mov dx,03f8h ! out dx,al ! mov ax,bx ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,rlr ! call ydbg ! pop dx ! pop bx ! pop ax	;TEMP DEBUG PROBE (#62): marker 97h, immediately after "mov rlr,ax" -- dump the value just written (saved into bx FIRST, same fix as marker 0Bh in #56 -- the first version of THIS probe had the identical bug, clobbering AL with the marker byte before dumping it) and read rlr straight back from memory
	mov p_link[si],0
		; We are now in NO-MAN's land
		; From now until the end of the
		; switch routine, There is no
		; process in context.
		; SI -> PD just taken out of context.
		; jump to routine for given status
	mov bh,0 ! mov bl,p_stat[si] ! shl bx,1
	push ax ! push bx ! push si ! mov al,'{' ! mov dx,03f8h ! out dx,al ! mov ax,si ! call ydbg ! mov al,':' ! mov dx,03f8h ! out dx,al ! mov ax,bx ! call ydbg ! mov al,'}' ! mov dx,03f8h ! out dx,al ! pop si ! pop bx ! pop ax	;TEMP DEBUG PROBE: dump si(pd just taken off rlr) and bx(dsp_table index*2)
	jmp cs:dsp_table[bx]

dsp_table	dw	disp_act	;00 - run
		dw	poll_act	;01 - poll device
		dw	delay_act	;02 - delay
		dw	swap_act	;03 - swap
		dw	term_act	;04 - terminate
		dw	sleep_act	;05 - sleep
		dw	disp_act	;06 - (nop)-dq
		dw	disp_act	;07 - (nop)-nq
		dw	flag_act	;08 - flag wait
					;09 - (nop)-ciowait

sleep_act:
;---------
; insert running process into list specified by
; u_dparam and set p_stat from p_scratch

	mov bx,u_dparam
	push si ! call insert_process
	pop si ! or p_flag[si],pf_resource
	mov al,p_scratch[si] ! mov p_stat[si],al
	jmp schedule

poll_act:
;--------
; set p_wait field of process = device number.
; put running process on poll list and wait
; for the device specified by u_dparam
;	input:	SI=pd address

	mov dx,u_dparam
	mov p_wait[si],dx
	mov ax,plr ! mov p_link[si],ax
	mov plr,si ! jmp schedule

delay_act:
;---------
; Put the running process on the Delay List.  The
; delay list is built such that any process's
; remaining delay time is the additive of the delay
; times of all processes ahead of it plus the # of
; ticks in it's own p_wait field.  At each clock tick
; the p_wait field of the top process in the list
; is decremented.  If it reaches zero (0), all
; processes with a zero in the p_wait field are
; placed on the dispatch ready list.
;	input:	SI=pd address

	push si ! mov al,io_strtclk
	call xiosif ! pop si
	mov bx,(offset dlr)-p_link
	mov cx,u_dparam ! inc cx
	cmp cx,0 ! jne del_lp
	    dec cx
del_lp:	mov di,p_link[bx]
	cmp di,0 ! je del_o
	    mov ax,p_wait[di]
	    cmp ax,cx ! ja del_o
		sub cx,ax ! mov bx,di ! jmps del_lp
del_o:	mov p_link[si],di ! mov p_link[bx],si
	mov p_wait[si],cx
	cmp di,0 ! je del_e
	    sub p_wait[di],cx
del_e:	jmp schedule

swap_act:
;--------
; put running process on swap list
;	input:	SI=pd address

	mov bx,(offset slr)-p_link
	call insert_process ! jmp schedule

flag_act:
;--------
; place running process in flag table to wait
; for next flag. Note, flag may have been set...
;	input:  SI=pd address
;		BX=address of Flag entry

	mov bx,u_dparam
	cmp flg_pd[bx],flag_on ! je gflagon
	    mov flg_pd[bx],si ! mov p_link[si],0
	    jmp schedule
gflagon:				; Flag set since wait check
	mov flg_pd[bx],flag_off
	jmps disp_act

term_act:
;--------
; terminate the running process
; free memory,free pd
;	input:	SI=pd address

	push ax ! mov al,'~' ! mov dx,03f8h ! out dx,al ! pop ax	;TEMP DEBUG PROBE
	mov ax,rlr
	push ax ! push bx ! push dx ! mov bx,ax ! mov al,95h ! mov dx,03f8h ! out dx,al ! mov ax,bx ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,si ! call ydbg ! pop dx ! pop bx ! pop ax	;TEMP DEBUG PROBE (#61/#62): marker 95h, term_act's own top -- dump the OLD rlr (saved into bx FIRST -- the first version of this probe had the same clobber-before-dump bug as marker 0Bh in #56, which #61's own "rlr=0A95" finding turned out to be an artifact of) and si (the terminating PD)
	mov p_link[si],ax
	mov rlr,si
	mov ch,0 ! mov cl,ncondev
nxtcon:	jcxz delst
	    dec cx ! mov p_cns[si],cl
	    push cx ! push si
	    mov cx,f_condetach ! call mpmif
	    pop si ! pop cx ! jmps nxtcon
delst:	mov cl,nlstdev
nxtlst:	jcxz free_nxt
	    dec cx ! mov dx,cx
	    add dl,ncondev
	    mov p_lst[si],dl
	    push cx ! push si
	    mov cx,f_lstdetach ! call mpmif
	    pop si ! pop cx ! jmps nxtlst
free_nxt:
	push si
	mov si,p_mem[si]
	test si,si ! jz end_free
	    push ds ! sub cx,cx ! push cx
	    push ms_start[si]
	    mov ax,ss ! mov ds,ax ! mov dx,sp
	    mov cx,f_memfree ! call mpmif
	    pop bx ! pop cx ! pop ds ! pop si
	    jmps free_nxt
end_free:
	mov mxmemowner,0
	mov dx,offset mxmemqpb ! mov cx,f_qwrite
	call mpmif
        pop si
	push ax ! push dx ! mov al,96h ! mov dx,03f8h ! out dx,al ! mov ax,si ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,p_link[si] ! call ydbg ! pop dx ! pop ax	;TEMP DEBUG PROBE (#61): marker 96h, right before "mov rlr,ax" at the end of term_act's cleanup -- dump si (terminating PD) and p_link[si] (should still be the OLD rlr value saved by marker 95h, if nothing clobbered it during the four nested mpmif calls in between)
	mov ax,p_link[si]
	mov rlr,ax
	mov p_link[si],0
	call freepd ! jmp schedule 

disp_act:
;--------
; 	place process on RLR
;	input:	SI=pd address

	mov p_stat[si],ps_run
	mov bx,(offset rlr)-p_link
	call insert_process
	push ax ! push dx ! mov al,'[' ! mov dx,03f8h ! out dx,al ! mov ax,rlr ! call ydbg ! pop dx ! pop ax	;TEMP DEBUG PROBE: dump rlr right after insert_process
	jmp schedule

;==============
insert_process:
;==============
;
; put PD# in list ordered by priority
;
; input:	BX = list root
	push ax ! push bx ! push dx ! mov al,8Fh ! mov dx,03f8h ! out dx,al ! mov ax,bx ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,si ! call ydbg ! pop dx ! pop bx ! pop ax	;TEMP DEBUG PROBE (#60): marker 8Fh, insert_process's own absolute top -- dump BX(list root offset) and SI(pd being inserted) on EVERY call, to see whether it's even reached a second time for TMP's own insert (drltorlr's own "call insert_process" after pulling TMP off drl)
;		SI = pd number

	 mov cx,p_flag[si] ! and cx,pf_resource
ins_npd: mov di,p_link[bx]
	 cmp di,0 ! jz ins_out
	    mov al,p_prior[di]
	    cmp al,p_prior[si]
	    ja ins_out
		jb ins_nxt
		    cmp cx,0 ! jz ins_nxt
			jmps ins_out
ins_nxt:	mov bx,di ! jmp ins_npd
ins_out: push ax ! push dx ! mov al,90h ! mov dx,03f8h ! out dx,al ! mov ax,bx ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,di ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,cx ! call ydbg ! pop dx ! pop ax	;TEMP DEBUG PROBE (#60): marker 90h, insert_process's own ins_out -- dump BX(final list position),DI(next-in-list),CX(resource flag) right before the ins_exit splice, to see exactly where TMP's own insert lands
	cmp cx,0 ! jz ins_exit
	    mov cx,pf_resource
	    not cx ! and p_flag[si],cx
ins_exit:
	 push ax ! push dx ! mov al,91h ! mov dx,03f8h ! out dx,al ! mov ax,bx ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,di ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,si ! call ydbg ! pop dx ! pop ax	;TEMP DEBUG PROBE (#60): marker 91h, ins_exit right before the splice writes -- dump BX,DI,SI, the three values about to be spliced together
	 mov p_link[si],di ! mov p_link[bx],si ! ret

;=========
schedule:
;=========
; poll all required devices and place any ready
; processes on the Ready List

		;we can enable interrupts now.
		;there MUST be a process on the RLR
		;at this point, ie. IDLE...
	sti ! cli	;TEMP/precautionary (#59): same one-instruction-delay
			;guard as the two confirmed instances of this bug --
			;applied here on the same pattern (bare "sti" followed
			;by a real instruction, not an immediate "cli"), but
			;NOT yet confirmed via its own probe the way the other
			;two were. Strictly narrows the interrupt-enabled
			;window, never widens it, so low-risk either way.
		;go through the Poll List
	mov di,(offset plr)-p_link
		;get the next PD on list.
		;DI is the last one which
		;has already been checked.
polld_another:
	mov si,p_link[di]
		;SI is the next PD to check
	cmp si,0 ! jz drltorlr
		;SI is valid PD, poll it.
	    push di ! mov cx,p_wait[si]
	    mov al,io_polldev ! call xiosif
	    pop di ! mov si,p_link[di]
		;if AL=0, device not ready.
	    cmp al,0 ! je polld_next
			;device ready,
			;move SI from PLR to RLR
		mov ax,p_link[si] ! mov p_link[di],ax
		push di ! mov bx,(offset rlr)-p_link
		mov p_stat[si],ps_run
		call insert_process ! pop si
			;p_link[SI]=next PD to check
polld_next:		;SI has been checked
	    mov di,si ! jmps polld_another

drltorlr:
;--------
; Pull all processes on the dispatch ready list and
; place them on the Ready List.

		;We must disable interrupts while
		;playing with DRL since interrupts
		;doing a Flag_set may also.
	cli ! mov si,drl
	sti ! cli	;#60: this is NOT the same as the original "sti !
			;jmps drltorlr" below (which this replaces) -- a
			;"sti" immediately followed by a JUMP is unsafe: the
			;one-instruction delay means an interrupt already
			;pending becomes eligible to fire right as the CPU
			;lands on the jump *target*'s own first instruction,
			;one instruction too early for that target's own
			;"cli" (if any) to matter. Confirmed via GDB
			;single-step trace: this exact "sti!jmps drltorlr"
			;pattern, at full speed, is where TMP's own PD
			;disappears from the ready list without a trace --
			;moving the brief re-enable to right here, followed
			;immediately by "cli" (no jump in between), keeps the
			;same "briefly let a pending Flag_set's interrupt
			;through between drl entries" intent from the
			;original comment above, but safely.
	push ax ! push dx ! mov al,12 ! mov dx,03f8h ! out dx,al ! mov ax,si ! call ydbg ! pop dx ! pop ax	;TEMP DEBUG PROBE: marker 12 (raw byte), dump drl at every drltorlr check
	cmp si,0 ! jz switch
	    mov ax,p_link[si] ! mov drl,ax
	    mov p_stat[si],ps_run
	    mov bx,(offset rlr)-p_link
	    call insert_process
	    jmps drltorlr

switch:
;------
; switch to the first process on the Ready List 

	mov bx,rlr
	push ax ! push bx ! push dx ! mov al,'<' ! mov dx,03f8h ! out dx,al ! mov ax,bx ! call ydbg ! mov al,'>' ! mov dx,03f8h ! out dx,al ! pop dx ! pop bx ! pop ax	;TEMP DEBUG PROBE: dump rlr (PD about to run)
	mov dx,p_uda[bx] ! mov ds,dx
	push dx				;UDA on stack
		; restore interrupt vectors
	mov ax,0 ! mov es,ax
	mov si,offset u_ivectors ! mov di,ax
	mov cx,10 ! rep movs ax,ax
	mov si,offset u_mpm_ip
	mov di,offset i_mpm_ip
	mov cx,4 ! rep movs ax,ax
		; restore registers
	mov ax,ds:u_ax
	mov bx,ds:u_bx
	mov cx,ds:u_cx
	mov dx,ds:u_dx
	mov si,ds:u_si
	mov di,ds:u_di
	mov bp,ds:u_bp
		; restore DS and ES and stack
	pop es
	mov ss,u_ss
	mov sp,u_sp
	mov ds,cs:sysdat	;bare form is wrong -- DS is still the
				;just-switched-to process's own UDA segment
				;here (set above via "mov ds,dx" from
				;p_uda[bx]), not sysdat-ish (same bug class
				;as the two fixes above)
	push ax ! push bx ! push dx ! mov al,8Ch ! mov dx,03f8h ! out dx,al ! mov al,u_in_int ! mov ah,0 ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,u_ds_sav ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,u_es_sav ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,ds ! call ydbg ! mov al,' ' ! out dx,al ! mov ax,es ! call ydbg ! pop dx ! pop bx ! pop ax	;TEMP DEBUG PROBE (#58): marker 8Ch, right before "cmp u_in_int,true" in switch -- dump u_in_int, u_ds_sav, u_es_sav, DS, ES for whichever process is about to be switched to, to see which exit path gets taken and whether u_ds_sav/u_es_sav are really sane
	cmp u_in_int,true ! jne dret
	    jmp int_disp_exit
dret:	push u_flag_sav ! popf
	mov indisp,false
	ret

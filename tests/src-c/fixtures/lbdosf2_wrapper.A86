; Standalone wrapper for src/loader/LBDOSF2.A86 -- see
; src-c/loader/lbdosf2.c's own header comment for exactly what's
; ported and what's deferred.
;
; Same minimal-wrapper approach as lbdosf1_wrapper.A86's own, extended
; to also include LBDOSIO.A86 (for staret/setlret1, which lbdosf2.c
; cross-calls for real -- same convention as src-c/kernel/que1.c's own
; cross-file calls into que2.c) and LBDOSF1.A86 (for every routine
; lbdosf2.c's own ported routines call into). `kbchar`/`compcol`/
; `column`/`listcp`/`aret` reuse lbdosio_wrapper.A86's own scratch
; addresses (0xB000-0xB005); LBDOSF1.A86's own fields reuse
; lbdosf1_wrapper.A86's own (0xB010+); neither overlaps this file's
; own new fields below.
cpmsegment	equ	0
biosoffset	equ	0
	include lbdosequ.a86
addlist		equ	8
dpblist		equ	15
	dseg
pererr		dw	0
roderr		dw	0
rofer		dw	0
seler		dw	0
	org	0B000h
kbchar		db	0
compcol		db	0
column		db	0
listcp		db	0
aret		dw	0
lret		equ	byte ptr aret
	org	0B010h
curdsk		db	0
info		dw	0
rodsk		dw	0
dmaad		dw	0
cdrmaxa		dw	0
curtrka		dw	0
curreca		dw	0
buffa		dw	0
dpbaddr		dw	0
checka		dw	0
alloca		dw	0
sectpt		dw	0
blkshf		db	0
blkmsk		db	0
extmsk		db	0
maxall		dw	0
dirmax		dw	0
chksiz		dw	0
offsetv		dw	0
tranv		dw	0
seqio		db	0
single		db	0
rcount		db	0
extval		db	0
vrecord		dw	0
lvrecord	equ	byte ptr vrecord
arecord		dw	0
ablock		dw	0
dptr		db	0
dcnt		dw	0
ldcnt		equ	byte ptr dcnt
drec		dw	0
dmabase		dw	0
parametersegment dw	0
; LBDOSF2.A86's own new scratch fields
dirblk		dw	0
usrcode		db	0
dirloc		db	0
srchl		db	0
srcha		dw	0
rmf		db	0
fcbcopied	db	0
efcb		db	0e5h
	cseg
	include lbdosio.a86
	include lbdosf1.a86
	include lbdosf2.a86
	end

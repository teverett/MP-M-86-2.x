; Standalone wrapper for src/kernel/QUE1.RTM (all 10 routines) and
; src/kernel/QUE2.RTM's rlsmx/getqdaddr/remqd/qspace/qrelease, on real
; memory layout. tests/src-c/test_que.py runs this with tools/i86sim.py's
; segmented=True: DS = the real SYSDAT segment, ES = the running
; process's UDA (the RTM's ambient ES), QPBs and caller buffers in that
; UDA's u_wrkseg.
;
; The real UDA.FMT/SYSDAT.FMT are included, so `rlr`/`qlr`/`qul`/`qmau`/
; `endseg`/`u_wrkseg` resolve to their genuine offsets -- the same ones
; src-c/kernel/que1.c/que2.c use. `sysdat` is the module's own cs:sysdat
; cell (normally RTMIF.RTM's), kept at cseg offset 0. `mpmif` (f_sleep/
; f_wakeup/f_cqwrite/f_maualloc/f_maufree) is a boundary stub.
	include system.def
	include pd.def
	include err.def
	include qd.def
	include mpb.def
	include modtab.def
	include modfunc.def
	cseg
sysdat	dw	0
mpmif	equ	9000h
	include que1.rtm
	include que2.rtm

	include uda.fmt
	include sysdat.fmt
	end

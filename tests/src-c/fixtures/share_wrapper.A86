; Standalone wrapper for src/kernel/SHARE.MEM: share_entry. Needs
; tools/i86sim.py's opt-in `segmented=True` mode (see src-c/kernel/
; ml.c's own header comment): the SAT scan near the end switches DS
; to the underlying MAU's own dynamically-supplied segment
; (`m_start[bx]`).
;
; `satlen`/`sat_start`/`sat_nall` (normally MAU.MEM's own equates) are
; redeclared directly here instead of pulling in the whole of
; MAU.MEM, which this port doesn't need -- same reasoning as
; ml_wrapper.A86's own identical redeclaration.
;
; `rlr`/`mdul`/`u_wrkseg` are DSEG labels at the scratch addresses
; src-c/kernel/defs.h and tests/src-c/test_share.py both use (see
; idle_wrapper.A86's comment for why, same reasoning as there).
	include system.def
	include pd.def
	include err.def
	include mem.def
sat_start	equ	word ptr 0
sat_length	equ	word ptr sat_start + word
sat_nall	equ	byte ptr sat_length + word
satlen		equ	sat_nall + byte
	dseg
	org	0A000h
rlr		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A028h
mdul		dw	0
	cseg
sysdat	dw	0		; normally supplied by this module's own init
	include util.mem
	include share.mem
	end

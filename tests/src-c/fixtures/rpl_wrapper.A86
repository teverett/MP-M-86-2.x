; Standalone wrapper for src/kernel/RPL.SUP's rpl_entry. See
; src-c/kernel/rpl.c's own header comment for why the whole routine
; collapses to its deterministic `rpl_err` path under this project's
; own boundary-stub convention (mpmif's own no-op-return leaves `cx`
; holding the just-loaded, never-zero f_qopen function code, so `cmp
; cx,0 ! jne rpl_err` is always taken) -- the real QPB-build/`retf`
; success path is never reached, so this wrapper needs nothing beyond
; the plain `mpmif` stub every other file here already uses.
;
; `u_wrkseg`/`u_retseg` are DSEG labels at the scratch addresses
; src-c/kernel/defs.h and tests/src-c/test_rpl.py both use
; (UDA_WRKSEG/UDA_RETSEG -- `u_wrkseg`'s is the same address src-c/
; kernel/share.c's own identical precedent already relies on -- see
; idle_wrapper.A86's comment for why a plain EQU would be wrong here,
; they're read as memory, not used as jump targets).
	include system.def
	include pd.def
	include err.def
	include qd.def
	include modfunc.def
	dseg
	org	0A012h
u_wrkseg	dw	0
	org	0A014h
u_retseg	dw	0
	cseg
sysdat	dw	0		; normally supplied by this module's own init
mpmif	equ	9000h		; unported external call target (stub)
	include rpl.sup
	end

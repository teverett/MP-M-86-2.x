; Standalone wrapper for src/kernel/CONSOLE.CIO's 6 trivial attach/detach
; entries plus their shared internal cioattach/ciodetach, and
; src/kernel/CHARIO.CIO's getccbadr (a tiny, fully self-contained
; dependency pulled in on its own -- the rest of CHARIO.CIO is a much
; larger, deeply interdependent state machine left for a future pass,
; see docs/src-c.md).
;
; `rlr`/`ccb` are DSEG labels at the scratch addresses src-c/kernel/defs.h
; and tests/src-c/test_console.py both use (see idle_wrapper.A86's
; comment for why, same reasoning as there).
	include system.def
	include pd.def
	include err.def
	include ccb.def
	include acb.def
	include modtab.def
	include modfunc.def
	dseg
	org	0A000h
rlr		dw	0
	org	0A030h
ccb		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A032h
thrdrt		dw	0
	org	0A034h
ncns		db	0
nlstdev		db	0
ncondev		db	0
	cseg
mpmif	equ	9000h		; unported external call target (stub)
	include console.cio
getccbadr:
;---------
; get CCB for calling proc's default console
;	input:	DH = console number
;		DL = character
;	output:	SI = address of ccb
;		BX = PD address
;		DX unchanged

	mov bx,rlr
	sub ax,ax ! mov al,dh
	shl ax,1 ! shl ax,1
	mov si,ccb ! add si,ax
	add si,ax ! add si,ax		;ccb+12(ccbnum)
	ret
	end

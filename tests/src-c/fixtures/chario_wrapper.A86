; Standalone wrapper for src/kernel/CHARIO.CIO's 9 entry points (+
; internal rawinit/coninit/getconnum/attach/echoc/conbrk/chkctl/
; control_p/prcsmsg/prname/conout/compout/stdout/ctlout/tabout/pspace/
; pbacksp/pcr/crlf/crlfp/conin), together with src/kernel/CONSOLE.CIO
; (which CHARIO.CIO's own attach/control_p call into: conattach_entry,
; condetach_entry, mimic_entry, unmimic_entry, lstattach_entry) and
; CHARIO.CIO's own getccbadr (shared by both files in the real build).
; `cioif.cio` (module init/dispatch glue) is deliberately not included
; here -- it's still unported, and nothing in this wrapper's own call
; graph reaches it.
;
; `rlr`/`ccb`/`ncns`/`nlstdev`/`ncondev` are DSEG labels at the scratch
; addresses src-c/kernel/defs.h and tests/src-c/test_chario.py both use
; (see idle_wrapper.A86's comment for why, same reasoning as there).
	include system.def
	include modfunc.def
	include xioscb.def
	include pd.def
	include err.def
	include qd.def
	include acb.def
	include ccb.def
	include char.def
	dseg
	org	0A000h
rlr		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A030h
ccb		dw	0
	org	0A032h
thrdrt		dw	0
	org	0A034h
ncns		db	0
nlstdev		db	0
ncondev		db	0
	cseg
mpmif	equ	9000h		; unported external call target (stub)
xiosif	equ	9010h		; unported external call target (stub)
	include console.cio
	include chario.cio
getccbadr:
;---------
; get CCB for calling proc's default console
;	input:	DH = console number
;		DL = character
;	output:	SI = address of ccb
;		BX = PD address
;		DX unchanged

	mov bx,rlr
	sub ax,ax ! mov al,dh
	shl ax,1 ! shl ax,1
	mov si,ccb ! add si,ax
	add si,ax ! add si,ax		;ccb+12(ccbnum)
	ret
	end

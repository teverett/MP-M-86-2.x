;       title   'Bdos Interface, Bdos, Version 2.2 Feb, 1980'
;*****************************************************************
;*****************************************************************
;**                                                             **
;**			L o a d e r				**
;**   B a s i c    D i s k   O p e r a t i n g   S y s t e m    **
;**            I n t e r f a c e   M o d u l e                  **
;**                                                             **
;*****************************************************************
;*****************************************************************
;
;       Copyright (c) 1978, 1979, 1980
;       Digital Research
;       Box 579, Pacific Grove
;       California
;
;
;       5 september, 1980
;	smaller version of BDOS for CP/M-86 Loader	
;
;**********************************************
;
cpmsegment      equ     0	; base of CP/M-86
ldroffset       equ     0   	; offset of CPMLDR
;
; bdosoffset/biosoffset/bdoscodesize are DRI's own fixed-layout values,
; carried over unmodified from the real LDBDOS.A86. DRI's build placed
; this module via Intel-hex "pip" (sparse, absolute-address records --
; no file bytes at all for addresses this module doesn't use), so an
; `org bdosoffset` here cost nothing. tools/asm86 emits raw binary,
; where the same `org` means literal zero-byte padding from file offset
; 0 up to bdosoffset -- which used to make this module's own entry
; point (right where `org bdosoffset` lands, see LBDOSENT.A86) sit at
; file-relative offset 0x400 inside its own LDBDOS.cseg.bin, while
; tools/build_mpmldr.py placed that *whole* blob (padding included)
; starting at LDMPM's own patched `ldbdos_offset` -- so the interrupt
; vector LDMPM patches to point at LDBDOS actually pointed at zero
; padding, not the real entry code, confirmed by inspecting the
; combined MPMLDR.bin directly (see docs/bugs.md's LDBDOS entry).
;
; Fixed by zeroing bdosoffset -- this module's position in the final
; image is now established purely by tools/build_mpmldr.py's own
; sequential concatenation, the same way LDMPM.A86/LDBIOS86Q.A86 are,
; with no internal self-positioning org of its own. biosoffset (used as
; an absolute CALL/JMP target into LDBIOS86Q's own jump table) and
; bdoscodesize (used to place this module's own DSEG data right after
; its real CSEG) are self-corrected by tools/build_mpmldr.py the same
; way it already self-corrects LDMPM.A86's own offset constants; the
; values below are only a seed for that first assemble-and-measure
; pass.
bdosoffset      equ     0	; LDBDOS's own position within MPMLDR.bin
biosoffset      equ     0e8fh   ; offset of LBIOS-86 (self-corrected)
bdoscodesize    equ     0aa0h   ; size of BDOS code (self-corrected)
;
eject ! include lbdosequ.a86	 ; symbol definition
eject ! include lbdosent.a86     ; entry module
eject ! include lbdosnew.a86     ; new 8086 BDOS functions
eject ! include lbdosio.a86      ; byte I/O module
eject ! include lbdosf1.a86      ; file system part 1
eject ! include lbdosf2.a86      ; file system part 2
eject ! include lbdosf3.a86      ; file system part 3
eject ! include lbdosdat.a86     ; data area
eject
;********************** end of BDOS ********************
end

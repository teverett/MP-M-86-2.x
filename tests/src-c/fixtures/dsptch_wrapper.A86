; Standalone wrapper for src/kernel/DSPTCH.RTM: fdisp, int_disp_exit,
; farpdisp/pdisp, dsptch, insert_process, schedule, switch (+ the
; whole dsp_table dispatch). Bundled with src/kernel/PROC.RTM (for
; `freepd`, called by `term_act`, as an ordinary internal call -- not
; a boundary stub). See src-c/kernel/dsptch.c's own header comment
; for why this file exists (a debugging aid for the live scheduler-
; hang investigation, not a linked kernel component) and for the
; real-hardware mechanisms (interrupt return, register save/restore
; across a context switch) that have no C equivalent at all.
;
; Needs tools/i86sim.py's `segmented=True` mode (dynamically-computed
; UDA segments, same as ml.c/proc.c/mau.c/share.c/load.c).
;
; UDA.FMT is redeclared as a real eseg block exactly as
; proc_wrapper.A86's own (copied verbatim, same reasoning there).
; `rlr`/`drl`/`dlr`/`plr`/`slr`/`thrdrt`/`pul`/`u_wrkseg`/`endseg`/
; `nlstdev`/`ncondev`/`indisp` are DSEG labels at the scratch
; addresses src-c/kernel/defs.h and tests/src-c/test_dsptch.py both
; use (see idle_wrapper.A86's comment for why).
	include system.def
	include pd.def
	include err.def
	include mem.def
	include flg.def
	include modfunc.def
	include xioscb.def
i_mpm_ip	equ	380h
mpmif	equ	9000h		; unported external call target (stub)
xiosif	equ	9001h		; ditto
	eseg
	org	0
u_dparam	dw	0
u_dma_ofst	dw	0
u_dma_seg	dw	0
u_func		db	0
u_searchl	db	0
u_searcha	dw	0
u_searchabase	dw	0
u_dcnt		dw	0
u_dblk		dw	0
u_error_mode	db	0
u_mult_cnt	db	0
u_df_password	rb	8
u_pd_cnt	db	0
u_in_int	db	0
u_sp		dw	0
u_ss		dw	0
u_ax		dw	0
u_bx		dw	0
u_cx		dw	0
u_dx		dw	0
u_di		dw	0
u_si		dw	0
u_bp		dw	0
u_wrkseg_f	dw	0
u_retseg	dw	0
u_ds_sav	dw	0
u_stack_sp	dw	0
u_stack_ss	dw	0
u_ivectors	rw	10
u_es_sav	dw	0
u_flag_sav	dw	0
u_initcs	dw	0
u_initds	dw	0
u_inites	dw	0
u_initss	dw	0
u_mpm_ip	dw	0
u_mpm_cs	dw	0
u_debug_ip	dw	0
u_debug_cs	dw	0
u_insys		db	0
u_stat_sav	db	0
	dseg
	org	0A000h
rlr		dw	0
	org	0A002h
drl		dw	0
	org	0A004h
dlr		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A01Ch
plr		dw	0
	org	0A01Eh
slr		dw	0
	org	0A026h
endseg		dw	0
	org	0A032h
thrdrt		dw	0
	org	0A035h
nlstdev		db	0
ncondev		db	0
	org	0A038h
pul		dw	0
	org	0A03Ah
mxmemowner	dw	0
	org	0AC00h
indisp		db	0
	org	0AC01h
es_sav		dw	0
bx_sav		dw	0
mxmemqpb	rb	16
	org	0AD00h
dsptchtos	rw	0
	cseg
sysdat	dw	0		; normally supplied by this module's own init
	include dsptch.rtm
	include proc.rtm
	end

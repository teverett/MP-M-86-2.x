; Standalone wrapper for src-assem/kernel/ABORT.RTM: sysreset_entry,
; terminate_entry (+ internal abt_chk), abort_spec_entry (+ internal
; find_pd, find_pdthrd, findpdnc, findpdq, fflgpd, snip_it,
; abt_putdrl, gccba, and the whole abort_tab dispatch). Needs
; tools/i86sim.py's `CALL r/m16`/`JMP r/m16` support (see src-c/
; kernel/abort.c's own header comment: `call cs:abort_tab[di]`).
;
; Bundled together with src-assem/kernel/QUE2.RTM (for `rlsmx`) and
; src-assem/kernel/FINDPD.RTM (for `findpdname_entry`), both called as
; ordinary internal calls by ABORT.RTM, not boundary stubs.
;
; On real memory layout: the real UDA.FMT/SYSDAT.FMT are included, so
; `rlr`/`drl`/`dlr`/`plr`/`slr`/`qlr`/`ccb`/`thrdrt`/`nflags`/`flags`/
; `mxmemowner`/`mxmemcount`/`mxmemqpb` and `u_wrkseg`/`u_error_mode`/
; `u_dparam`/`u_in_int`/`u_sp`/`u_ss` resolve to their genuine offsets
; -- the same ones src-c/kernel/abort.c uses. tests/src-c/test_abort.py
; runs it with tools/i86sim.py's segmented=True (DS = SYSDAT, ES = the
; running process's UDA).
	include system.def
	include pd.def
	include err.def
	include qd.def
	include mpb.def
	include ccb.def
	include flg.def
	include apb.def
	include modfunc.def
mpmif	equ	9000h		; unported external call target (stub)
dsptch	equ	9001h		; unported dispatcher entry (stub, JMP boundary
				; -- see abort.c's own header comment)
pdisp	equ	9002h		; ditto
	cseg
sysdat	dw	0		; normally supplied by RTMIF.RTM's own init
	include que2.rtm
	include findpd.rtm
	include abort.rtm

	include uda.fmt
	include sysdat.fmt
	end

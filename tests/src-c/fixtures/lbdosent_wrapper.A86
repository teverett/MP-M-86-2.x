; Standalone wrapper for src/loader/LBDOSENT.A86 -- see
; src-c/loader/lbdosent.c's own header comment for exactly what's
; ported. Same minimal-wrapper approach as lbdosf3_wrapper.A86's own
; (same scratch dseg layout, verbatim), extended with LBDOSENT.A86
; itself (included for real here, unlike lbdosf3_wrapper.A86's own
; copy-pasted parsave/parsave33/parunsave-only excerpt, since this
; wrapper's whole job is exercising the real `oldbdos` dispatch).
cpmsegment	equ	0
biosoffset	equ	0
bdosoffset	equ	0
	include lbdosequ.a86
addlist		equ	8
dpblist		equ	15
	dseg
pererr		dw	0
roderr		dw	0
rofer		dw	0
seler		dw	0
	org	0B000h
kbchar		db	0
compcol		db	0
column		db	0
listcp		db	0
aret		dw	0
lret		equ	byte ptr aret
	org	0B010h
curdsk		db	0
info		dw	0
rodsk		dw	0
dmaad		dw	0
cdrmaxa		dw	0
curtrka		dw	0
curreca		dw	0
buffa		dw	0
dpbaddr		dw	0
checka		dw	0
alloca		dw	0
sectpt		dw	0
blkshf		db	0
blkmsk		db	0
extmsk		db	0
maxall		dw	0
dirmax		dw	0
chksiz		dw	0
offsetv		dw	0
tranv		dw	0
seqio		db	0
single		db	0
rcount		db	0
extval		db	0
vrecord		dw	0
lvrecord	equ	byte ptr vrecord
arecord		dw	0
ablock		dw	0
dptr		db	0
dcnt		dw	0
ldcnt		equ	byte ptr dcnt
drec		dw	0
dmabase		dw	0
parametersegment dw	0
; LBDOSF2.A86's own new scratch fields
dirblk		dw	0
usrcode		db	0
dirloc		db	0
srchl		db	0
srcha		dw	0
rmf		db	0
fcbcopied	db	0
efcb		db	0e5h
; LBDOSF3.A86/LBDOSENT.A86's own new scratch fields
dlog		dw	0
resel		db	0
fcbdsk		db	0
olddsk		db	0
linfo		db	0
parcopfl	db	0
parlg		db	0
infosave	dw	0
loc_par_area	rb	258
	cseg
; LBDOSENT.A86 own `org bdosoffset` (=0 here) resets the cseg write
; cursor back to this module's own base -- same real include order
; src/loader/LDBDOS.A86 itself uses (LBDOSENT.A86 first), since
; including it AFTER the others would silently overwrite their own
; code at this same address (confirmed by hitting exactly that
; while writing this wrapper: `return`'s own real "ret" byte came
; back as 0x00, clobbered by LBDOSENT.A86's own leading `db
; 0,0,0,0,0,0 ! JMP bdose` preamble landing right back at address 0).
	include lbdosent.a86
; LBDOSENT.A86's own `bdose` prologue/epilogue scratch cells (no C
; equivalent, not ported -- see src-c/loader/lbdosent.c's own header
; comment) and its own 4 error messages (real content, errflg prints
; them for real) -- these are cseg-resident in the real LBDOSDAT.A86
; (not included here), so declared directly in cseg, NOT in the
; dseg block above (confirmed by hitting exactly that mistake first:
; placed in dseg, `dskmsg`/etc resolved to 0xB1xx scratch addresses
; with no real bytes behind them at all, so `print`'s own $-scan
; read nothing but zeros forever).
axsave		dw	0
SS_save		dw	0
SP_save		dw	0
endstack	equ	offset $
dskmsg		db	'Bdos Err On '
dskerr		db	' : $'
permsg		db	'Bad Sector$'
selmsg		db	'Select$'
rofmsg		db	'File '
rodmsg		db	'R/O$'
	include lbdosnew.a86
	include lbdosio.a86
	include lbdosf1.a86
	include lbdosf2.a86
	include lbdosf3.a86
	end

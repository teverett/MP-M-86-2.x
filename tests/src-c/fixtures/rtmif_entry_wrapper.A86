; Standalone wrapper for src/kernel/RTMIF.RTM's `entry` (the module's
; own inter-module RTM dispatch), together with the real SYSENT.RTM,
; FLAG.RTM, QUE1.RTM, QUE2.RTM, FINDPD.RTM, and ABORT.RTM its own
; `function` table dispatches into -- same combination src/kernel/
; RTM.A86 itself assembles, minus PROC.RTM/DSPTCH.RTM.
;
; `dsptch`/`pdisp`/`proc_creat` are plain EQU stub addresses here
; (same convention tests/src-c/fixtures/sysent_wrapper.A86's own
; ORIGINAL, simpler version used, before creat_proc_wrapper.A86
; bundled the real PROC.RTM/DSPTCH.RTM in just for `creat_proc_entry`'s
; own dedicated test) -- NOT because they're boundary stubs under the
; usual convention (PROC.RTM/DSPTCH.RTM are both fully ported), but
; because `terminate_entry`'s own real tail (`jmp dsptch`, confirmed
; by single-stepping: it falls straight through `rlsmx` into a REAL
; scheduling pass, `dispin`/`freepd`/etc., which this test's minimal
; PD-list setup isn't built to survive) and `creat_proc_entry`'s own
; real tail (`call proc_creat ! jmp pdisp`) share the exact same
; `dsptch` label once this module is combined for real -- there is no
; way to let ONE of those two tails run for real without the other
; also running for real. `test_rtmif_entry.py` accepts the resulting
; gap for `creat_proc_entry` (case 14) explicitly, the same way
; test_memif_entry.py already accepts an analogous gap for 9 of its
; own 13 cases -- see that test's own header comment for the matching
; precedent, and this file's own test for the exact reasoning here.
;
; `rlr`/`drl`/`dlr`/`nflags`/`flags`/`u_wrkseg`/`plr`/`slr`/`qlr`/
; `qul`/`qmau`/`endseg`/`ccb`/`thrdrt`/`nlstdev`/`ncondev`/`pul`/
; `mxmemowner`/`mxmemcount`/`mxmemqpb` are DSEG labels at the scratch
; addresses src-c/kernel/defs.h and test_rtmif_entry.py both use (see
; idle_wrapper.A86's comment for why, same reasoning as there) --
; merging que_wrapper.A86's/flag_wrapper.A86's/abort_wrapper.A86's own
; separate layouts into defs.h's one canonical address per field.
;
; Like tests/src-c/fixtures/cioif_entry_wrapper.A86/
; memif_entry_wrapper.A86, this wrapper DOES include RTMIF.RTM, whose
; own real `mpmif`/`xiosif` are treated as plain no-op boundary stubs
; by test_rtmif_entry.py -- consistent with every other RTM-module
; file's own existing test (QUE1.RTM's/QUE2.RTM's/ABORT.RTM's own
; internal `call mpmif` sites are already ordinary boundary stubs
; there too).
	include system.def
	include pd.def
	include err.def
	include mem.def
	include flg.def
	include modfunc.def
	include xioscb.def
	include qd.def
	include mpb.def
	include modtab.def
	include apb.def
	include ccb.def
	include uda.fmt
	cseg	; UDA.FMT leaves the segment as ESEG; everything from here
		; on is real code and belongs back in CSEG (findpd_wrapper
		; .A86's own precedent).
dsptch		equ	9000h	; unported dispatcher entry (stub) -- see
				; this file's own header comment for why
pdisp		equ	9001h	; ditto
proc_creat	equ	9002h	; ditto
fdisp		equ	9003h	; only `init`'s own `offset fdisp` needs this
				; to exist to assemble (init is never run here)
farpdisp	equ	9004h	; ditto, `offset farpdisp`
	dseg
	org	0A000h
rlr		dw	0
	org	0A002h
drl		dw	0
	org	0A004h
dlr		dw	0
	org	0A006h
nflags		db	0
	org	0A008h
flags		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A01Ch
plr		dw	0
	org	0A01Eh
slr		dw	0
	org	0A020h
qlr		dw	0
qul		dw	0
qmau		dw	0	; not touched by any of the 6 included
				; files' own ported functions (confirmed
				; by grep), only needed to exist for
				; QUE1.RTM/QUE2.RTM to assemble
	org	0A026h
endseg		dw	0
	org	0A030h
ccb		dw	0
	org	0A032h
thrdrt		dw	0
	org	0A035h
nlstdev		db	0
ncondev		db	0
	org	0A038h
pul		dw	0
	org	0A03Ah
mxmemowner	dw	0
	org	0A03Ch
mxmemcount	db	0
	org	0A040h
mxmemqpb	rb	16
; SYSDAT.FMT module-table/PD fields RTMIF.RTM's own `init` touches --
; dummy placeholders only, since `init` itself is never executed by
; this test (it starts straight at `entry`), same "exists only to
; assemble" convention as idle_wrapper.A86's own unrelated labels.
	org	0A880h
supmod		rw	2
	org	0A890h
xiosmod		rw	2
	org	0A8A0h
dispatcher	rw	2
rtm_pdisp	rw	2
	org	0A8B0h
tickpd		rb	pdlen
	org	0A8E0h
idlepd		rb	pdlen
	cseg
sysdat	dw	0		; normally supplied by RTMIF.RTM's own init
	include rtmif.rtm
	include sysent.rtm
	include flag.rtm
	include que1.rtm
	include que2.rtm
	include findpd.rtm
	include abort.rtm
	end

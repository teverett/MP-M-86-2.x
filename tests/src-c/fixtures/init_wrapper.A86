; Standalone wrapper for src/kernel/INIT.SUP's `init`, laid out like
; the real SUP module: INIT.SUP at the very start of the SUP code
; segment (org 0, so `sysdat`/`supervisor`/`ver` sit at their real
; offsets), and the real VEC.FMT/UDA.FMT/SYSDAT.FMT included for the
; interrupt vector table, UDA, and system data area -- so every field
; `init` touches resolves to its genuine offset, the same ones
; src-c/kernel/init.c uses. tests/src-c/test_init.py runs this with
; tools/i86sim.py's segmented=True and real CS/DS values.
;
; `entry`/`notick`/`idle`/`user_entry`/`xiosif` are real labels in
; other SUP files (SUPIF.SUP/TICK.SUP/IDLE.SUP) -- bare markers here,
; since `init` only ever takes their offsets (or, for xiosif, makes a
; near call the test stubs out). The five `callf ...mod[bx]` module
; inits are stubbed by instruction address (far_call_stub_addrs).
	include system.def
	include modfunc.def
	include modtab.def
	include xioscb.def
	include pd.def
	include rsp.def

	include init.sup

	cseg
entry:		ret
notick:		ret
idle:		ret
user_entry:	ret
xiosif:		ret

	include vec.fmt
	include uda.fmt
	include sysdat.fmt
	end

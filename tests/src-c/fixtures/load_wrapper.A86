; Standalone wrapper for src/kernel/LOAD.SUP's `load:`/`load_entry`/
; `cload_entry` plus `diskread`/`load_group`/`load_finish`. Bundles
; the real MEMORY.MEM/MAU.MEM/ML.MEM/UTIL.MEM/CPMMEM.MEM too, so
; `load`'s own real `mpmif(f_malloc)`/`mpmif(f_memfree)` calls and
; `cload_entry`'s own `mpmif(f_freemem)` call (plus their own real
; `mpmif(f_maualloc)`/`mpmif(f_mlalloc)` calls in turn) have real code
; to redirect into -- `tests/src-c/test_load.py`'s own combined
; `mpmif` hook does that redirect in Python (manually pushing a return
; address and jumping into the real routine's own resolved symbol
; address) rather than writing a real dispatcher here, since `mpmif`
; also needs to keep Python-simulating `f_setdmab`/`f_setdma`/
; `f_freadseq` (see load.c's own header comment on `freadseq`)
; through that exact same shared call site.
;
; Needs tools/i86sim.py's `segmented=True` mode (see src-c/kernel/
; ml.c's own header comment): the chosen group's own Base Page
; segment, the new process's own UDA segment, and that process's own
; user-stack segment are all dynamically computed.
;
; UDA.FMT is redeclared here as a real `eseg`/`org 0` block (not an
; EQU -- same reasoning as proc_wrapper.A86's own identical
; redeclaration: a bare reference to one of its fields is implicitly
; ES-relative in the real build, which only a real `eseg` label
; reproduces). BASEP.FMT/LSTK.FMT are genuinely `DSEG` in the real
; build (not `eseg`), so a bare reference to one of *their* fields is
; plain DS-relative -- EQUs (with the usual byte/word ptr casts,
; needed for a `mov field,immediate` to assemble unambiguously) are
; correct for them.
;
; `rlr`/`u_wrkseg`/`load_pd`/`load_fcb`/`load_nldtabents`/
; `load_basep`/`load_8080`/`load_uda`/`load_lstk`/`ldtab` are DSEG
; labels at the scratch addresses src-c/kernel/defs.h and tests/
; src-c/test_load.py both use (see idle_wrapper.A86's comment for why,
; same reasoning as there).
	include system.def
	include pd.def
	include err.def
	include ldtab.def
	include mem.def
	include mpb.def
	include cmdh.def
	include fcb.def
	include modfunc.def
mpmif	equ	9000h		; unported external call target (stub) --
				; the real asm's own front half (not
				; exercised at runtime by this port's own
				; test, which enters at lb_more) calls it
				; for real disk I/O/allocation; only needs
				; to assemble here, never actually executes
; src/kernel/BASEP.FMT, src/kernel/LSTK.FMT -- redeclared as real
; `aseg` labels (not EQUs: a bare "mov ls_offset,dx"-shaped reference
; to an EQU with its own word/byte ptr cast mis-assembles as an
; unsupported mem,mem combo here, confirmed directly -- same
; underlying assembler limitation proc_wrapper.A86's own comment on
; UDA.FMT describes, just hit from the plain-DSEG side instead of the
; eseg-auto-prefix side). `aseg` gives them their own independent,
; zero-based counter so BASEP (org 0) and LSTK (org 56h) can share it
; without colliding with each other or with UDA.FMT's own `eseg`
; below -- correct here since the two are never read through the same
; real segment at once anyway (load_basep vs. load_lstk).
	aseg
	org	0
bpg_clen	rb	3
bpg_cseg	dw	0
bpg_8080	db	0
	org	0Fh
bpg_eseg	dw	0
	org	80h
bpg_dma		rb	0
	org	56h
ls_sp		rb	0
ls_offset	dw	0
ls_cseg		dw	0
ls_flags	dw	0
ls_roffset	dw	0
ls_rcseg	dw	0
; src/kernel/UDA.FMT -- redeclared as a real eseg block, same
; reasoning/subset style as proc_wrapper.A86's own (only the fields
; this port touches).
	eseg
	org	0
u_dparam	dw	0
u_dma_ofst	dw	0
u_dma_seg	dw	0
	org	50h
u_initcs	dw	0
u_initds	dw	0
u_inites	dw	0
u_initss	dw	0
	org	34h
u_stack_sp	dw	0
	dseg
	org	0A000h
rlr		dw	0
	org	0A028h
mdul		dw	0
mal		dw	0
mfl		dw	0
	org	0A032h
thrdrt		dw	0
	org	0A900h
load_pd		dw	0
load_fcb	dw	0
load_nldtabents	dw	0
load_basep	dw	0
load_8080	db	0
load_uda	dw	0
load_lstk	dw	0
	org	0A910h
ldtab		rb	200
	org	0A9E0h
load_chain	db	0
load_nrelsegs	dw	0
load_minwanted	dw	0
load_maxwanted	dw	0
load_indma	dw	0
	org	0AA00h
mxloadqpb	rb	16
	org	0AB00h
load_dma	rb	dskrecl
	org	0A012h
u_wrkseg	dw	0
	cseg
lstklen	equ	96
sysdat	dw	0		; normally supplied by this module's own init
user_retf:	ret		; dummy stand-in: the real label lives in
				; COMMAND.SUP, which this port has no use
				; for beyond its own resolved address
	include load.sup
	include memory.mem
	include mau.mem
	include ml.mem
	include util.mem
	include cpmmem.mem
	end

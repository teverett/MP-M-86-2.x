
;*****************************************************
;*
;*	Idle Process
;*
;*****************************************************

;====
idle:		;Idle Process
;====
; Jump to the XIOS idle routine

	mov ds,cs:sysdat	;bare form wrong, same bug class/fix as
				;INIT.SUP's nrsp (see its comment)
	mov bx,rlr
	mov es,p_uda[bx]
	mov ax,io_idle
	jmp xiosif

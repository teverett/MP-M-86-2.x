; Standalone wrapper for src/kernel/CPMMEM.MEM's maxmem_entry,
; absmax_entry, cpmalloc_entry, cpmabsa_entry, cpmfree_entry (+ internal
; getmemory, free_memory -- both real calls now, see cpmmem.c's own
; header comment). freeall_entry is deliberately not wrapped -- its
; entire body is a boundary tail-jump into mpmif, nothing to port.
;
; Every "push ds ! mov ds,u_wrkseg" here is the same already-established
; pattern MEMORY.MEM's malloc_entry/mfree_entry use (a fixed per-process
; scratch segment, not a dynamically-*different*-each-time one) -- not
; the blocked PROC.RTM/ML.MEM/MAU.MEM/SHARE.MEM addressing gap. u_wrkseg
; itself is never actually read by tools/i86sim.py's flat memory model
; (segment overrides are no-ops there), so its own value doesn't matter
; for this wrapper -- it just needs to exist as a word so `mov
; ds,u_wrkseg` assembles.
;
; `rlr` is a DSEG label at the scratch address src-c/kernel/defs.h and
; tests/src-c/test_cpmmem.py both use (see idle_wrapper.A86's comment
; for why, same reasoning as there).
;
; mpmif is now a real dispatcher for f_malloc/f_memfree (+ the two
; nested function codes malloc_entry's/mfree_entry's own real bodies
; make their own further mpmif calls for: f_maualloc/f_mlalloc/
; f_maufree/f_mlfree), same pattern as memory_mem_wrapper.A86's own
; mpmif: tail-jumps into the real MEMORY.MEM/MAU.MEM/ML.MEM/UTIL.MEM
; bundled below, whose own "ret" returns straight to getmemory's/
; free_memory's own caller -- see cpmmem.c's own header comment.
; mdul/mal/mfl/thrdrt are the same scratch dseg labels
; memory_mem_wrapper.A86 uses.
	include system.def
	include pd.def
	include err.def
	include mem.def
	include mpb.def
	include modtab.def
	include modfunc.def
	dseg
	org	0A000h
rlr		dw	0
	org	0A012h
u_wrkseg	dw	0
	org	0A028h
mdul		dw	0
mal		dw	0
mfl		dw	0
	org	0A032h
thrdrt		dw	0
	cseg
sysdat	dw	0		; normally supplied by this module's own init
mpmif:
	cmp cx,f_malloc ! je mpmif_malloc
	cmp cx,f_memfree ! je mpmif_memfree
	cmp cx,f_maualloc ! je mpmif_maualloc
	cmp cx,f_mlalloc ! je mpmif_mlalloc
	cmp cx,f_maufree ! je mpmif_maufree
	cmp cx,f_mlfree ! je mpmif_mlfree
	ret
mpmif_malloc:	jmp malloc_entry
mpmif_memfree:	jmp mfree_entry
mpmif_maualloc:	jmp maualloc_entry
mpmif_mlalloc:	jmp mlalloc_entry
mpmif_maufree:	jmp maufree_entry
mpmif_mlfree:	jmp mlfree_entry
	include cpmmem.mem
	include memory.mem
	include mau.mem
	include ml.mem
	include util.mem
	end

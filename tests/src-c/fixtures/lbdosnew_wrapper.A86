; Standalone wrapper for src/loader/LBDOSNEW.A86's func51 (set segment
; base for disk I/O). `dmabase` is a DSEG label at the scratch address
; src-c/loader/defs.h and tests/src-c/test_lbdosnew.py both use (see
; lbdosio_wrapper.A86's own comment for why), declared directly here
; rather than via `include lbdosdat.a86`.
cpmsegment	equ	0
biosoffset	equ	0
	include lbdosequ.a86
	dseg
	org	0B043h
dmabase		dw	0
	cseg
	include lbdosnew.a86
	end
